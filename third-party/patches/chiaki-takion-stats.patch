+				CHIAKI_LOGI(control->takion->log, "Network in the last %u ms: from the console %llu of %llu packets lost (%.1f%%), "
+					"to the console %u packets sent again and %u never acknowledged",
+					(unsigned int)(now_ms - log_since_ms), (unsigned long long)log_lost, (unsigned long long)log_total,
+					log_total ? 100.0 * (double)log_lost / (double)log_total : 0.0, (unsigned int)resent, (unsigned int)given_up);
+			}
+			log_since_ms = now_ms;
+			log_received = log_lost = 0;

diff --git a/lib/include/chiaki/takionsendbuffer.h b/lib/include/chiaki/takionsendbuffer.h
--- a/lib/include/chiaki/takionsendbuffer.h
+++ b/lib/include/chiaki/takionsendbuffer.h
@@ -32,6 +32,10 @@
 	bool should_stop;
 	bool alive; // false after fini: Takion's thread can end before the stream connection sends its disconnect
 	ChiakiThread thread;
+	// Only written by the Send Buffer thread, read by the congestion control thread for its log line (32 bit: no torn
+	// reads on 32 bit ARM; it only looks at differences, so wrapping is fine)
+	volatile uint32_t resent; // packets sent again because the console didn't acknowledge them in time
+	volatile uint32_t given_up; // packets dropped after TAKION_DATA_RESEND_TRIES_MAX tries without acknowledgement
 } ChiakiTakionSendBuffer;
 
 

+		log_received += received;
+		log_lost += lost;
+		uint64_t now_ms = chiaki_time_now_monotonic_ms();
+		if(now_ms - log_since_ms >= CONGESTION_CONTROL_LOG_INTERVAL_MS)
+		{
+			uint32_t resent = send_buffer->resent - log_resent;

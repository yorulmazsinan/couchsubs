+// The console answered the search and is still in pairing mode: retrying only the TCP connect can still succeed,
+// while a new search after a failed attempt is refused by the console.
+#define REGIST_REQUEST_CONNECT_ATTEMPTS 3
+#define REGIST_REQUEST_CONNECT_RETRY_MS 500
+
+// Text of the last socket error (errno, or WSAGetLastError on Windows). Must be called right after the failing call.
+static void regist_socket_error_str(char *buf, size_t buf_size)
+{
+#ifdef _WIN32
+	snprintf(buf, buf_size, "WSA error %d", WSAGetLastError());
+#else
+	snprintf(buf, buf_size, "%s", strerror(errno));
+#endif
+}
 

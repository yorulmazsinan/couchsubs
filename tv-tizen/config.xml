<!-- required_version 2.4: 2016 Samsung TV'ler (Tizen 2.4) de kurabilsin; yeni TV'ler daha düşük sürüm isteyen paketi
     de kurar. Issue #71'de 2016 model 40KU7000'de (Tizen 2.4) doğrulandı. İzinlerin hepsi "public" düzeyde; Samsung'un
     herkese verdiği geliştirici sertifikası yeter. Sayfa ES5 ile yazıldığı için eski tarayıcılarda da çalışır. -->
<!-- required_version 3.0: 2017 Samsung TV'ler (Tizen 3.0) de kurabilsin; yeni TV'ler daha düşük sürüm isteyen paketi
     de kurar. İzinlerin hepsi "public" düzeyde; Samsung'un herkese verdiği geliştirici sertifikası yeter. Sayfa ES5 ile
     yazıldığı için Tizen 3.0'ın tarayıcısında (Chromium 47) da çalışır. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/yorulmazsinan/couchsubs" version="0.9.124" viewmodes="maximized">
    <tizen:application id="CouchSubsT.CouchSubs" package="CouchSubsT" required_version="2.4"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <!-- base_screen_resolution ayarı yok (0.9.55). 0.9.27–0.9.54'teki "fullscreen" değeri Samsung'un belgesinde yok ve
         4K/8K TV'de uygulama yüzeyini panelin kendi pikselinde açıyordu (QE75QN900A 'scr 3840x2160'); TVWindow 1920x1080
         uzayında kalıp büyütülmeden çizildiği için PS5 görüntüsü sol üst köşede küçük kalıyordu. Başka projede de aynı
         değerden sonra 8K TV'de yazılar küçüldü (jellyfin-tizen #315). Ayarsız uygulama Samsung'un "Managing Screen
         Resolution" belgesindeki standart 1920x1080 yüzeyde açılır, TV onu ve HDMI penceresini panele büyütür. Ultra geniş
         monitörde (#304, Odyssey G8 3440x1440) ayar etkisizdi (0.9.49–0.9.53: her kaynak 1920x1080); Sarı tuş tam
         genişlik yöntemlerini dener (platform.js). 32:9 Odyssey G9'da (#886) ise ayar yüzeyi 32:9 açıyordu ve 0.9.55'ten
         beri uygulama 16:9 kutuda kaldı (3840x1080 pencere NotSupportedError). Bu yüzden bilgisayar ve telefon, 8001
         yanıtı ultra geniş monitör diyorsa (model LS34/LS49/LS57… ya da çözünürlük oranı >= 1,9) paketi kurarken ayarı ve
         width=device-width görünümünü ekler (WideScreenPackage: Windows/Mac, iPhone, Android); TV'lere paket değişmeden
         gider. Ayarı buraya geri eklemeden önce scripts/tv-tizen.test.js'teki açıklamaya bakın. -->
    <icon src="icon.png"/>
    <name>CouchSubs</name>
    <author>Enmera</author>
    <license>AGPL-3.0-only</license>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>
    <!-- "http://tizen.org/privilege/power" yok: Samsung TV'lerde Tizen Power API'si bulunmaz, izin TV'nin izin listesinde
         değildir. Tizen 2.4 (2016 TV'ler) tanımadığı izni içeren paketi "install failed[118]" ile reddeder (#497); yeni
         TV'ler yok sayar. İzin eklerken scripts/tv-tizen.test.js'teki TV listesine bakın. -->
    <!-- Samsung ağ API'si (webapis.network.getIp): Tizen sistem bilgisi adres vermezse TV kendi ağını bilsin. -->
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>

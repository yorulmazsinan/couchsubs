<!-- required_version 3.0: 2017 Samsung TV'ler (Tizen 3.0) de kurabilsin; yeni TV'ler daha düşük sürüm isteyen paketi
     de kurar. İzinlerin hepsi "public" düzeyde; Samsung'un herkese verdiği geliştirici sertifikası yeter. Sayfa ES5 ile
     yazıldığı için Tizen 3.0'ın tarayıcısında (Chromium 47) da çalışır. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/yorulmazsinan/couchsubs" version="0.9.17" viewmodes="maximized">
    <tizen:application id="CouchSubsT.CouchSubs" package="CouchSubsT" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>CouchSubs</name>
    <author>Enmera</author>
    <license>AGPL-3.0-only</license>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>

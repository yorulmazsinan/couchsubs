<!-- Yalnız debug yapısı: Play ekran görüntüleri ve ön plan hizmeti videosu için demo kaynağı (sürüm yapısına girmez). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Açılışta demo açıksa PS5 oturumu yerine klip kaynağını kurar. -->
        <provider
            android:name=".demo.DemoInstaller"
            android:authorities="${applicationId}.demo"
            android:exported="false" />
        <!-- adb shell am start -n com.couchsubs.mobile/.demo.DemoActivity -ez demo true -->
        <activity
            android:name=".demo.DemoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>

<!-- İkinci PlayStation hesabıyla giriş (Mac PSNLoginStep): tek hesap kartı. Girişliyse yeşil nokta + "Giriş yapıldı" ve sağda küçük
     "Yeniden Giriş Yap"; değilse tek ana "Giriş Yap". Tarayıcıda giriş ve hesap kimliğini elle girme "Diğer Giriş Yolları"nda. -->
<UserControl x:Class="CouchSubs.App.Views.Steps.PsnLoginStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Second PlayStation Account'}"
                  Message="{t:T 'CouchSubs connects to the PS5 by itself with a second account. You keep playing with your main account.'}">
        <c:SpacedStack Gap="s" MaxWidth="640" HorizontalAlignment="Left">
            <c:AccountCard x:Name="Account" Badge="PS" Title="{t:T 'PlayStation Account'}" SignedIn="{Binding HasAccount, Mode=OneWay}" SignIn="OnSignIn">
                <c:SpacedStack>
                    <!-- Uygulama içi giriş Sony'nin "Can't connect to the server" hatasında kalırsa giriş sistem tarayıcısında yapılır,
                         yönlendirme adresi buraya yapıştırılır (panoya kopyalanınca kendiliğinden alınır). -->
                    <Button x:Name="ShowBrowser" Content="{t:T 'Sign In in the Browser'}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="OnShowBrowser" />
                    <c:SpacedStack x:Name="BrowserPanel" Gap="s" Visibility="Collapsed">
                        <TextBlock x:Name="BrowserReason" Style="{StaticResource HintText}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="{t:T 'Sony\'s sign-in page could not reach its server inside the app, so sign-in moved to your browser.'}" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="{t:T 'Sign in with your second account in the browser that opened. When you finish, the browser stays on a remoteplay.dl.playstation.net page that only says redirect. Click the address bar, copy the whole address and come back here. CouchSubs picks up the copied address by itself; if it does not, paste it below and press Save.'}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BrowserUrl" PreviewKeyDown="OnBrowserKeyDown" />
                            <Button Grid.Column="1" Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="{t:Sp 's,0,0,0'}" Click="OnSaveBrowser" />
                        </Grid>
                        <Button Content="{t:T 'Open the Browser Again'}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenBrowser" />
                        <TextBlock x:Name="BrowserError" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
                    </c:SpacedStack>
                    <!-- Sony girişi açılmıyorsa (ör. servis sağlayıcı engelliyor) hesap kimliği elle yazılır. -->
                    <Button x:Name="ShowManual" Content="{t:T 'Enter Account ID Manually'}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="OnShowManual" />
                    <c:Unit x:Name="Manual" Visibility="Collapsed"
                            Hint="{t:T 'If Sony\'s sign-in page does not open (some internet providers block it), enter the second account\'s PSN account ID in base64 (12 characters, e.g. AbCdEfGhIjk=).'}">
                        <c:SpacedStack Gap="xs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManualId" MaxLength="24" FontFamily="{StaticResource MonoFont}" PreviewKeyDown="OnManualKeyDown" />
                                <Button Grid.Column="1" Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="{t:Sp 's,0,0,0'}" Click="OnSaveManual" />
                            </Grid>
                            <TextBlock x:Name="ManualError" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
                        </c:SpacedStack>
                    </c:Unit>
                </c:SpacedStack>
            </c:AccountCard>
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
        </c:SpacedStack>
    </c:StepLayout>
</UserControl>

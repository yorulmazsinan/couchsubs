<UserControl x:Class="CouchSubs.App.Views.Steps.XboxLoginStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Sign in with your Microsoft account'}"
                  Message="{t:T 'Link your Xbox account with a Microsoft device code, as in Greenlight. The sign-in page opens in your default browser.'}">
        <StackPanel>
            <TextBlock Text="{t:T 'Signed in'}" Style="{StaticResource DoneText}" Margin="0,0,0,12"
                       Visibility="{Binding HasXboxAccount, Converter={StaticResource VisibleIf}}" />
            <Button x:Name="SignIn" Content="{t:T 'Sign in with Microsoft'}" Style="{StaticResource PrimaryButton}" Click="OnSignIn" />
            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,12,0,8">
                <TextBlock Text="{t:T 'Your code (click to copy):'}" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                <!-- Kod tıklanınca kopyalanır; seçilip kopyalanabilsin diye salt okunur kutu. -->
                <TextBox x:Name="Code" IsReadOnly="True" FontSize="30" FontWeight="Bold" BorderThickness="0" Background="Transparent"
                         Cursor="Hand" PreviewMouseLeftButtonUp="OnCopyCode" Margin="0,0,0,4" />
                <TextBlock Margin="0,0,0,8">
                    <Hyperlink x:Name="Link" RequestNavigate="OnOpenLink"><Run x:Name="LinkText" /></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="Steps" Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="Status" Style="{StaticResource HintText}" TextWrapping="Wrap" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <!-- Hata olunca Xbox satırlarının da yazıldığı günlük açılır (Mac ve PS5 adımındaki gibi). -->
            <Button Content="{t:T 'Show log file'}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnShowLog"
                    Visibility="{Binding Text, ElementName=Error, Converter={StaticResource VisibleIf}}" />
            <!-- #853: oyun bu bilgisayardaki Xbox uygulamasında / play.xbox.com'da (ya da capture card ile OBS'te) oynanıyorsa
                 CouchSubs Xbox'a bağlanmaz, yalnız seçilen pencereyi okur; Microsoft girişi ve Xbox seçimi atlanır. -->
            <c:Card Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{t:T 'Playing with the Xbox app or play.xbox.com on this computer?'}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,90,0" />
                        <Button Content="{t:T 'Select'}" HorizontalAlignment="Right" Click="OnUseXboxWindow" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{t:T 'CouchSubs reads only the window you select in Settings › Picture source (the Xbox app, play.xbox.com or OBS with a capture card). It doesn\'t connect to the Xbox, so no Microsoft sign-in is needed and your Xbox session isn\'t interrupted.'}" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </c:StepLayout>
</UserControl>

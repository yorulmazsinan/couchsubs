<UserControl x:Class="CouchSubs.App.Views.Steps.TestStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout x:Name="Layout" Title="{t:T 'Let\'s test it'}"
                  Message="{t:T 'CouchSubs will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game.'}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Send" Content="{t:T 'Send test subtitle'}" Style="{StaticResource PrimaryButton}" Click="OnSend" />
                <!-- TV seçilmediyse ("TV'm yok") pencerenin yeri burada ayarlanabilir. -->
                <Button x:Name="Adjust" Content="{t:T 'Adjust the subtitle window'}" Margin="12,0,0,0" Click="OnAdjust" Visibility="Collapsed" />
            </StackPanel>
            <c:Card x:Name="Question" Title="{t:T 'Do you see it on the TV?'}" Margin="0,20,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{t:T 'Yes, I see it'}" Style="{StaticResource PrimaryButton}" Click="OnYes" IsDefault="True" />
                        <Button Content="{t:T 'No'}" Margin="12,0,0,0" Click="OnNo" />
                    </StackPanel>
                    <TextBlock x:Name="Hint" Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{t:T 'If you don\'t see it, make sure the CouchSubs TV app is open and connect the TV again.'}" />
                </StackPanel>
            </c:Card>
            <TextBlock Style="{StaticResource HintText}" Margin="0,20,0,0" TextWrapping="Wrap"
                       Text="{t:T 'CouchSubs sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings.'}" />
        </StackPanel>
    </c:StepLayout>
</UserControl>

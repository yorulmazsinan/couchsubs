<UserControl x:Class="CouchSubs.App.Views.Steps.TestStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout x:Name="Layout" Title="{t:T 'Let\'s Try It'}"
                  Message="{t:T 'We test each part one by one. You should see a sample Turkish subtitle on the TV.'}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Send" Content="{t:T 'Send test subtitle'}" Style="{StaticResource PrimaryButton}" Click="OnSend" />
                <!-- TV seçilmediyse ("TV'm yok") pencerenin yeri burada ayarlanabilir. -->
                <Button x:Name="Adjust" Content="{t:T 'Position the subtitles'}" Margin="{t:Sp 's,0,0,0'}" Click="OnAdjust" Visibility="Collapsed" />
            </StackPanel>
            <c:Card x:Name="Question" Title="{t:T 'Do you see it on the TV?'}" Margin="{t:Sp '0,m,0,0'}" Visibility="Collapsed">
                <StackPanel>
                    <!-- İlişkili ardışık düğmeler alt alta, aralar 12 (Mac DSButtonStack). -->
                    <c:SpacedStack Gap="related" HorizontalAlignment="Left">
                        <Button Content="{t:T 'Yes, I see it'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="OnYes" IsDefault="True" />
                        <Button Content="{t:T 'No'}" HorizontalAlignment="Stretch" Click="OnNo" />
                    </c:SpacedStack>
                    <TextBlock x:Name="Hint" Style="{StaticResource HintText}" Margin="{t:Sp '0,s,0,0'}"
                               Text="{t:T 'If you don\'t see it, make sure the CouchSubs TV app is open and connect the TV again.'}" />
                </StackPanel>
            </c:Card>
            <!-- TV kurulumu bitti: her çeviride TV uygulaması kendiliğinden açılmaya çalışılır; açılmazsa TV'den açılır. -->
            <TextBlock x:Name="AutoOpenNote" Style="{StaticResource HintText}" Margin="{t:Sp '0,m,0,0'}" TextWrapping="Wrap"
                       Text="{t:T 'Every time you start translating, CouchSubs tries to open the TV app by itself. If it doesn\'t open, open CouchSubs on the TV.'}" />
            <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,m,0,0'}" TextWrapping="Wrap"
                       Text="{t:T 'CouchSubs sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings.'}" />
        </StackPanel>
    </c:StepLayout>
</UserControl>

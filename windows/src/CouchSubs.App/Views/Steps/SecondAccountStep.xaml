<!-- İkinci PlayStation hesabı (Mac AccountStep): solda bir kez yapılan dört madde (tıklanınca yeşil tik), "İkinci Hesabım Yok" ve
     önemli uyarı kutusu; sağda Sony'nin hesap açma sayfasının QR kodu (yerel üretilir) ve "Sayfayı Bu Bilgisayarda Aç".
     Windows'a özgü: PS Remote Play / chiaki-ng indirme bağlantıları ve OBS / oyun penceresi seçeneği. -->
<UserControl x:Class="CouchSubs.App.Views.Steps.SecondAccountStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Second PlayStation Account'}"
                  Message="{t:T 'CouchSubs connects to the PS5 by itself with a second account. You keep playing with your main account.'}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{t:Sp l}" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <c:SpacedStack Gap="l">
                <c:Card>
                    <c:SpacedStack>
                        <StackPanel>
                            <TextBlock Text="{t:T 'Done once'}" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="{t:T 'Sony\'s PS Remote Play app can\'t be used meanwhile.'}" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" />
                            <c:SpacedStack Gap="xs" Margin="{t:Sp '0,m,0,0'}">
                                <ToggleButton Style="{StaticResource StepToggle}" Tag="1">
                                    <TextBlock Text="{t:T 'Create a free account on playstation.com with a different email address.'}" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource StepToggle}" Tag="2">
                                    <TextBlock Text="{t:T 'On the PS5, choose Add User and sign in once with the new account.'}" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource StepToggle}" Tag="3">
                                    <TextBlock Text="{t:T 'While still on the new user, go to Settings › System › Remote Play and turn on Enable Remote Play.'}" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource StepToggle}" Tag="4">
                                    <TextBlock Text="{t:T 'Switch back to your own user. You only do this once.'}" />
                                </ToggleButton>
                            </c:SpacedStack>
                        </StackPanel>
                        <!-- İkinci hesabı olmayanlar: görüntü bu bilgisayardaki Remote Play penceresinden okunur, PSN girişi ve PS5 eşleştirmesi atlanır. -->
                        <c:SpacedStack Gap="s">
                            <Button Content="{t:T 'I Don\'t Have a Second Account: Read the Remote Play Window'}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Click="OnUseRemotePlayWindow" />
                            <!-- İkisi de kurulu değilse resmi indirme sayfaları (ikisi de denenebilir). -->
                            <c:SpacedStack x:Name="DownloadPanel" Gap="s" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{t:T 'PS Remote Play and chiaki-ng aren\'t installed on this PC.'}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{t:T 'Download PS Remote Play'}" Style="{StaticResource CompactButton}" Margin="{t:Sp '0,0,xs,0'}" Click="OnDownloadSony" />
                                    <Button Content="{t:T 'Download chiaki-ng'}" Style="{StaticResource CompactButton}" Click="OnDownloadChiaki" />
                                </StackPanel>
                            </c:SpacedStack>
                        </c:SpacedStack>
                        <!-- Kol ikinci hesaba atanırsa ana hesapla açılan oyun onu kendi kolu saymaz (GitHub #231). -->
                        <c:Callout x:Name="MainAccountWarning" />
                    </c:SpacedStack>
                </c:Card>
                <!-- Windows'a özgü: OBS projektörü ya da oyun penceresi bu bilgisayardaysa yalnız o pencere okunur. -->
                <Button Style="{StaticResource OptionRowButton}" Click="OnUseCaptureWindow">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource GlyphText}" FontSize="12" Foreground="{DynamicResource faintBrush}" />
                        <c:SectionTitle Title="{t:T 'Have OBS or a game window on this PC?'}" Margin="{t:Sp '0,0,s,0'}"
                                        Text="{t:T 'CouchSubs can read only the OBS projector or game window you select in Settings › Picture source. No second PSN account or additional capture app is needed.'}" />
                    </DockPanel>
                </Button>
                <!-- PS5 bağlıyken "Uzaktan Oynama bağlandı" yazısı kalıcıdır; bildirim ayarı değil, bu ayar gizler (GitHub #177). -->
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                           Text="{t:T 'To hide the &quot;Remote Play connected&quot; message on the screen: on the PS5, go to Settings › System › Remote Play and turn on Hide Remote Play Connection Status Pop-Up. Do it for both your main account and the second account.'}" />
            </c:SpacedStack>
            <c:Card Grid.Column="2" Title="{t:T 'Scan with Your Phone'}" VerticalAlignment="Top">
                <c:SpacedStack>
                    <Border Background="White" CornerRadius="{DynamicResource radius.control}" Padding="{t:Sp 's'}" HorizontalAlignment="Center">
                        <Image x:Name="SignUpCode" Width="168" Height="168" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="{t:T 'The code opens Sony\'s free account sign-up page.'}" Style="{StaticResource HintText}" />
                    <Button Content="{t:T 'Open the Page on This Computer'}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="OnOpenSignUp" />
                </c:SpacedStack>
            </c:Card>
        </Grid>
    </c:StepLayout>
</UserControl>

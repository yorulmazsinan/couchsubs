<UserControl x:Class="CouchSubs.App.Views.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout x:Name="Layout" Title="{t:T 'Welcome to CouchSubs'}"
                  Message="{t:T 'CouchSubs reads the English subtitles of your PS5 games and shows a Turkish translation on your TV, on top of the game. You keep playing on the TV with your own controller.'}">
        <StackPanel>
            <c:Card Title="{t:T 'Choose your console'}">
                <StackPanel>
                    <RadioButton x:Name="Ps5" Content="PlayStation 5" GroupName="consoleKind" Margin="{t:Sp '0,0,0,s'}" Checked="OnSelected" />
                    <RadioButton x:Name="Xbox" Content="{t:T 'Xbox Series / Xbox One (Beta)'}" GroupName="consoleKind" Checked="OnSelected" />
                </StackPanel>
            </c:Card>
            <TextBlock x:Name="Requirements" Margin="{t:Sp '0,m,0,0'}" TextWrapping="Wrap" Style="{StaticResource HintText}" />
            <!-- Kullanım verisi ilk açılışta bir kez söylenir (telefonlardaki karşılama ekranıyla aynı anlam). -->
            <TextBlock Margin="{t:Sp '0,m,0,0'}" TextWrapping="Wrap" Style="{StaticResource HintText}"
                       Text="{t:T 'CouchSubs measures how the app is used without linking it to you; no subtitle text, picture or account data is sent. You can turn this off in Settings › Game packs › Usage data.'}"
                       Visibility="{Binding ShowsUsageNotice, Converter={StaticResource VisibleIf}}" />
        </StackPanel>
    </c:StepLayout>
</UserControl>

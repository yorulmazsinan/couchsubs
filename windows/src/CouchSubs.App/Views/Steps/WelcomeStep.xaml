<!-- 01 · Konsol (Mac ConsoleChoiceStep): üç seçenek kartı (PlayStation 5, Xbox Series, Oyun Penceresi). "Oyun Penceresi" seçiliyken
     Devam, görüntüyü seçilen pencereden okur ve kurulumu bitirir (pencere Ayarlar'dan seçilir). -->
<UserControl x:Class="CouchSubs.App.Views.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout x:Name="Layout" Title="{t:T 'Which console do you play on?'}"
                  Message="{t:T 'CouchSubs gets the picture from the console over your local network. Nothing is installed on your console.'}">
        <c:SpacedStack Gap="l">
            <UniformGrid Rows="1">
                <RadioButton x:Name="Ps5" Style="{StaticResource ConsoleCard}" Tag="PS5" GroupName="consoleKind" Margin="{t:Sp '0,0,s,0'}" Checked="OnSelected">
                    <c:SectionTitle Title="PlayStation 5" Text="{t:T 'With Remote Play'}" />
                </RadioButton>
                <RadioButton x:Name="Xbox" Style="{StaticResource ConsoleCard}" Tag="Xbox" GroupName="consoleKind" Margin="{t:Sp 'xs,0,xs,0'}" Checked="OnSelected">
                    <c:SectionTitle Title="{t:T 'Xbox Series'}" Text="{t:T 'With Remote Features'}" />
                </RadioButton>
                <RadioButton x:Name="GameWindow" Style="{StaticResource ConsoleCard}" Tag="{t:T 'Window'}" GroupName="consoleKind" Margin="{t:Sp 's,0,0,0'}" Checked="OnWindow">
                    <c:SectionTitle Title="{t:T 'Game Window'}" Text="{t:T 'Remote Play, OBS, Capture Card'}" />
                </RadioButton>
            </UniformGrid>
            <TextBlock x:Name="Requirements" TextWrapping="Wrap" Style="{StaticResource HintText}" />
            <!-- Kullanım verisi ilk açılışta bir kez söylenir (telefonlardaki karşılama ekranıyla aynı anlam). -->
            <TextBlock TextWrapping="Wrap" Style="{StaticResource HintText}"
                       Text="{t:T 'CouchSubs measures how the app is used without linking it to you; no subtitle text, picture or account data is sent. You can turn this off in Settings › Game packs › Usage data.'}"
                       Visibility="{Binding ShowsUsageNotice, Converter={StaticResource VisibleIf}}" />
        </c:SpacedStack>
    </c:StepLayout>
</UserControl>

<!-- Kurulum sihirbazı: solda adım listesi (tamamlanan ✓, sıradaki numaralı, şimdiki vurgulu), sağda adım karosu, altında Geri / Devam. -->
<UserControl x:Class="CouchSubs.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <Grid Margin="{DynamicResource pad.screen}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: logo, "Kurulum", adımlar, sayaç ve ilerleme -->
        <c:Card Width="{DynamicResource size.sidebarWidth}" Padding="12,20" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,16">
                    <Grid Width="32" Height="32">
                        <Image Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Koyu temada logonun kenarı zeminden ayrılsın. -->
                        <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="7.2" />
                    </Grid>
                    <TextBlock Text="{t:T 'Setup'}" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,16,12,0">
                    <TextBlock x:Name="Counter" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="StepList" />
                </ScrollViewer>
            </DockPanel>
        </c:Card>

        <!-- Sağ: adım ve alttaki düğmeler -->
        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button x:Name="BackButton" Content="{t:T 'Back'}" MinWidth="160" MinHeight="{DynamicResource size.buttonLarge}" Click="OnBack" />
                <Button x:Name="ContinueButton" Content="{t:T 'Continue'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        MinWidth="200" MinHeight="{DynamicResource size.buttonLarge}" IsDefault="True" IsEnabled="{Binding CanAdvance}" Click="OnContinue" />
            </Grid>
            <c:Card Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="StepHost" Margin="32" />
                </ScrollViewer>
            </c:Card>
        </DockPanel>
    </Grid>
</UserControl>

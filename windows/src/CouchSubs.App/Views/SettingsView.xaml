<UserControl x:Class="CouchSubs.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:s="clr-namespace:CouchSubs.App.Views.Steps"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        xmlns:local="clr-namespace:CouchSubs.App.Views"
        Foreground="{DynamicResource textPrimaryBrush}">
    <!-- Ayarlar (Mac SettingsPage ile aynı düzen): solda 240 genişlikte menü kartı (her bölümde renkli simge karesi + ad +
         iki kelimelik alt yazı; seçili bölümün amber yumuşak hapı satırlar arasında kayar; arkada yavaş renk geçişi). Kart
         içeriği kadar uzar ve sağdaki sayfa kayarken üstte sabit kalır. Sağda seçili sayfa: iki sütun, her ayar bir birim
         (başlık üstte, denetim altta, açıklama en altta; birimler arası 24, ayraç yok). -->
    <!-- Perde: sayfa bütün pencereyi kaplar; cam üst çubuk ve reklam şeridi içeriğin üstünde durur. Menü kartı çubukların
         arasında sabit (shell.inset + 24); sağdaki sayfa kendi içinde kayar ve içeriği çubukların arkasından geçer (boşluk
         kayan içeriğin içinde). Sağ sütunun başında seçili bölümün başlığı (renkli simge karesi + başlık + alt yazı). -->
    <Grid Margin="{t:Sp 'l,0'}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{t:Sp l}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Padding="{DynamicResource shell.inset}" VerticalAlignment="Top">
        <Grid x:Name="NavCard" Width="{DynamicResource size.settingsNav}" VerticalAlignment="Top" Margin="{t:Sp '0,l'}">
            <Border Background="{DynamicResource surfaceBrush}" CornerRadius="{DynamicResource radius.card}" />
            <c:NavGlow x:Name="Glow" />
            <Border BorderBrush="{DynamicResource cardEdgeBrush}" BorderThickness="1" CornerRadius="{DynamicResource radius.card}" Padding="{t:Sp 's'}"
                    SnapsToDevicePixels="True">
                <Grid x:Name="NavHost">
                    <!-- Seçim hapı: seçili satırın konumuna kayar (SettingsView.MoveSelection). -->
                    <Border x:Name="Selection" Style="{StaticResource NavSelection}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SelectionOffset" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="Nav">
                        <c:NavItem Content="{t:T 'Basics'}" Hint="{t:T 'Translation, Sound'}" Icon="&#xE9E9;" Tint="{DynamicResource amberBrush}" Tag="0" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Subtitle Appearance'}" Hint="{t:T 'Size, Colors'}" Icon="&#xE8D2;" Tint="{DynamicResource peachBrush}" Tag="1" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Advanced'}" Hint="{t:T 'Engine, On-Screen Text'}" Icon="&#xE713;" Tint="{DynamicResource logoBackBrush}" Tag="2" Checked="OnNav" />
                        <Border Height="1" Background="{DynamicResource borderBrush}" Margin="{t:Sp 's,xs'}" />
                        <c:NavItem Content="{t:T 'Subtitle Area'}" Hint="{t:T 'Frame, Extra Areas'}" Icon="&#xE8B3;" Tint="{DynamicResource oliveBrush}" Tag="3" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Game Packs'}" Hint="{t:T 'Ready Translations'}" Icon="&#xE7B8;" Tint="{DynamicResource oliveBrush}" Tag="4" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Turkish Dubbing'}" Hint="{t:T 'Voices, Characters'}" Icon="&#xE8D6;" Tint="{DynamicResource plumBrush}" Tag="5" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Output Screens'}" Hint="{t:T 'TV, OBS'}" Icon="&#xE7F4;" Tint="{DynamicResource tealBrush}" Tag="6" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Keyboard Shortcuts'}" Hint="{t:T 'Translation Keys'}" Icon="&#xE765;" Tint="{DynamicResource skyBrush}" Tag="7" Checked="OnNav" Margin="{t:Sp '0,0,0,xxs'}" />
                        <c:NavItem Content="{t:T 'Console and Source'}" Hint="{t:T 'PS5, Xbox'}" Icon="&#xE7FC;" Tint="{DynamicResource logoBackBrush}" Tag="8" Checked="OnNav" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Border>
        <TabControl x:Name="Sections" Grid.Column="2" Style="{StaticResource SettingsPageTabs}" SelectionChanged="OnSection">
            <!-- ───── Temel ───── -->
            <TabItem x:Name="BasicsSection">
                <Grid Margin="{t:Sp '0,0,0,l'}" c:Responsive.StackBelow="{x:Static c:Responsive.TwoColumnMin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{t:Sp l}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SpacedStack Gap="l">
                        <!-- Çeviri: Hızlı / Dengeli / Doğru (kötü okunan satırların bekleme süreleri) -->
                        <c:Card Title="{t:T 'Translation'}">
                            <c:SpacedStack>
                                <c:Unit Title="{t:T 'Speed'}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegmentGroup}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="PaceFast" Style="{StaticResource SegmentButton}" GroupName="pace" Content="{t:T 'Fast'}" Tag="Fast" Checked="OnPace" />
                                                <RadioButton x:Name="PaceBalanced" Style="{StaticResource SegmentButton}" GroupName="pace" Content="{t:T 'Balanced'}" Tag="Balanced" Checked="OnPace" />
                                                <RadioButton x:Name="PaceAccurate" Style="{StaticResource SegmentButton}" GroupName="pace" Content="{t:T 'Accurate'}" Tag="Accurate" Checked="OnPace" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock x:Name="PaceHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" />
                                    </StackPanel>
                                </c:Unit>
                                <c:Unit Title="{t:T 'Translation Language'}" Hint="{t:T 'The game language is detected by itself.'}">
                                    <TextBlock Text="{t:T 'Turkish'}" />
                                </c:Unit>
                            </c:SpacedStack>
                        </c:Card>
                        <!-- Ses, hareket ve görünüm -->
                        <c:Card Title="{t:T 'Sound'}">
                            <c:SpacedStack>
                                <c:SwitchRow x:Name="StartupSound" Content="{t:T 'Startup Sound'}" Description="{t:T 'Plays only on the first launch.'}"
                                             Checked="OnStartupSound" Unchecked="OnStartupSound" />
                                <c:SwitchRow x:Name="TransitionAnimations" Content="{t:T 'Transition Animations'}" Description="{t:T 'When off, only a short fade is used.'}"
                                             Checked="OnTransitionAnimations" Unchecked="OnTransitionAnimations" />
                                <c:Unit Title="{t:T 'Appearance'}">
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="AppearanceLight" Style="{StaticResource SegmentButton}" GroupName="appearance" Content="{t:T 'Light'}" Tag="Light" Checked="OnAppearance" />
                                            <RadioButton x:Name="AppearanceDark" Style="{StaticResource SegmentButton}" GroupName="appearance" Content="{t:T 'Dark'}" Tag="Dark" Checked="OnAppearance" />
                                            <RadioButton x:Name="AppearanceSystem" Style="{StaticResource SegmentButton}" GroupName="appearance" Content="{t:T 'Follow System'}" Tag="System" Checked="OnAppearance" />
                                        </UniformGrid>
                                    </Border>
                                </c:Unit>
                            </c:SpacedStack>
                        </c:Card>
                    </c:SpacedStack>
                    <!-- Altyazı görünümü özeti -->
                    <c:Card Grid.Column="2" Title="{t:T 'Subtitle appearance'}" VerticalAlignment="Top">
                        <c:SpacedStack>
                            <!-- Perde önizlemesi (16:9, 20 köşe, sıcak sahne + projeksiyon ışığı); altyazı ayarların renk ve boyuyla. -->
                            <ContentControl x:Name="MiniPreview" Focusable="False" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{t:T 'Text size, background, text and character name colors. The settings apply the same on the TV, phone and computer screen.'}" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnEditAppearance">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="→" />
                                    <TextBlock Text="{t:T 'Edit Subtitle Appearance'}" />
                                </DockPanel>
                            </Button>
                        </c:SpacedStack>
                    </c:Card>
                </Grid>
            </TabItem>

            <!-- ───── Altyazı Görünümü ───── -->
            <TabItem x:Name="AppearanceSection">
                <c:SpacedStack Gap="l" Margin="{t:Sp '0,0,0,l'}">
                    <!-- Önizleme, yazı boyutu, zemin, yazı ve karakter adı renkleri (AppearanceEditor). -->
                    <ContentControl x:Name="AppearanceHost" Focusable="False" />
                </c:SpacedStack>
            </TabItem>

            <!-- ───── Gelişmiş ───── -->
            <TabItem x:Name="TranslationSection">
                <Grid Margin="{t:Sp '0,0,0,l'}" c:Responsive.StackBelow="{x:Static c:Responsive.TwoColumnMin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{t:Sp l}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Card Title="{t:T 'Translation engine'}" VerticalAlignment="Top">
                        <c:SpacedStack>
                            <!-- Motor seçimi (Mac AdvancedSettings): her motor bir seçenek kartı (1 px kenarlık, seçiliyken 2 px amber + hafif
                                 amber dolgu). Seçili motor kodda gizli Engine kutusunda tutulur (eski ayar yolları aynen çalışır).
                                 GroupName YOK: kartlar aynı panelin çocukları olarak kendi aralarında gruplanır. WPF aynı GroupName'li
                                 düğmeleri görünmeyen sekmelerde (görsel kökü yok) birbirine bağlar; Dublaj kartının "engine" grubu
                                 Ayarlar'a her girişte buradaki seçimi siliyordu (#1298). -->
                            <c:SpacedStack x:Name="EngineOptions" Gap="xs">
                                <c:OptionCard Tag="Free" Content="{t:T 'Free Translation'}" Description="{t:T 'On this computer, offline'}" MinHeight="72" Checked="OnEngineOption" />
                                <c:OptionCard Tag="Gemini" Content="Google Gemini" Description="{t:T 'Better translation with a free Google key.'}" MinHeight="72" Checked="OnEngineOption" />
                                <c:OptionCard Tag="DeepL" Content="DeepL" Description="{t:T 'With your own DeepL key.'}" MinHeight="72" Checked="OnEngineOption" />
                                <c:OptionCard Tag="OpenAi" Content="OpenAI" Description="{t:T 'With your own key.'}" MinHeight="72" Checked="OnEngineOption" />
                                <c:OptionCard Tag="Claude" Content="Anthropic Claude" Description="{t:T 'With your own key.'}" MinHeight="72" Checked="OnEngineOption" />
                                <c:OptionCard Tag="Local" Content="{t:T 'Local Model'}" Description="{t:T 'Ollama or LM Studio; no quota.'}" MinHeight="72" Checked="OnEngineOption" />
                            </c:SpacedStack>
                            <c:Unit>
                                <StackPanel>
                                    <ComboBox x:Name="Engine" SelectionChanged="OnEngine" Visibility="Collapsed">
                                        <ComboBoxItem Content="{t:T 'Free (on this computer)'}" Tag="Free" />
                                        <ComboBoxItem Content="DeepL" Tag="DeepL" />
                                        <ComboBoxItem Content="Google Gemini" Tag="Gemini" />
                                        <ComboBoxItem Content="OpenAI" Tag="OpenAi" />
                                        <ComboBoxItem Content="Anthropic Claude" Tag="Claude" />
                                        <ComboBoxItem Content="{t:T 'Local model (Ollama, LM Studio)'}" Tag="Local" />
                                    </ComboBox>
                                    <TextBlock x:Name="EngineHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" />
                                </StackPanel>
                            </c:Unit>
                            <c:Unit Title="{t:T 'Free translation device'}">
                                <StackPanel>
                                    <ComboBox x:Name="TranslationDeviceChoice" SelectionChanged="OnTranslationDevice">
                                        <ComboBoxItem Content="{t:T 'CPU (default)'}" Tag="Cpu" />
                                        <ComboBoxItem Content="{t:T 'GPU (Beta) · NVIDIA CUDA'}" Tag="Gpu" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'CPU works on every computer. GPU needs a compatible NVIDIA card; the first time you choose it, CouchSubs downloads about 565 MB of CUDA files from NVIDIA (about 790 MB on disk). If unavailable, CouchSubs uses CPU.'}" />
                                    <TextBlock Style="{StaticResource ErrorText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Visibility="{Binding GpuFallbackWarning, Converter={StaticResource VisibleIf}}"
                                               Text="{t:T 'GPU could not be used; free translation is running on CPU.'}" />
                                </StackPanel>
                            </c:Unit>
                            <c:Unit x:Name="CpuThreadPanel" Title="{t:T 'CPU translation threads'}" Visibility="Collapsed">
                                <StackPanel>
                                    <ComboBox x:Name="CpuThreadChoice" SelectionChanged="OnCpuThreads" />
                                    <TextBlock x:Name="CpuThreadWarning" Style="{StaticResource ErrorText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed"
                                               Text="{t:T 'This uses most of your CPU threads and may slow down the game.'}" />
                                </StackPanel>
                            </c:Unit>
                            <TextBlock x:Name="EnglishOnlyHint" Style="{StaticResource HintText}" Visibility="Collapsed"
                                       Text="{t:T 'Online engines translate English games only. For other game languages the free translation is used.'}" />
                            <!-- Ücretsiz çeviri zayıf kalıyor; ücretsiz Gemini anahtarı en kolay iyileştirme (Mac ile aynı). -->
                            <c:Callout x:Name="FreeGeminiOffer" Text="{t:T 'For better translation, get a free Gemini key.'}">
                                <Button Content="{t:T 'Get a free key'}" Style="{StaticResource CompactButton}" Margin="{t:Sp '0,s,0,0'}" Click="OnFreeGemini" />
                            </c:Callout>
                            <StackPanel x:Name="FreeGeminiNotes" Visibility="Collapsed">
                                <c:SwitchRow x:Name="GeminiPaidTier" Content="{t:T 'I use a paid Gemini API key'}"
                                             Description="{t:T 'Paid API keys may incur charges. Google still enforces quotas.'}"
                                             Checked="OnGeminiPaidTier" Unchecked="OnGeminiPaidTier" />
                                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,s,0,0'}"
                                           Text="{t:T 'Subtitle text is sent to Google. With a free key, Google may use it to improve its products, and people at Google may read it. Only the game\'s subtitles are sent.'}" />
                                <TextBlock x:Name="FreeGeminiLimit" Style="{StaticResource HintText}" Margin="{t:Sp '0,titleBody,0,0'}"
                                           Text="{t:T 'The free key has a per-minute limit. When it is reached, that line is translated by the free translation.'}" />
                            </StackPanel>
                            <c:SpacedStack x:Name="KeyPanel">
                                <!-- Model adı yazılamaz; yalnız ortak listedeki modeller seçilir. -->
                                <c:Unit x:Name="ModelPanel" Title="{t:T 'Model'}">
                                    <ComboBox x:Name="ModelChoice" SelectionChanged="OnModel" />
                                </c:Unit>
                                <!-- Yerel model (Ollama, LM Studio): adres ve model adı alandan çıkınca kaydedilir (Mac ile aynı). -->
                                <c:SpacedStack x:Name="LocalPanel" Visibility="Collapsed">
                                    <c:Unit Title="{t:T 'Server address'}">
                                        <StackPanel>
                                            <TextBox x:Name="LocalAddress" LostFocus="OnLocalChanged" KeyDown="OnLocalKey" />
                                            <c:SpacedStack Orientation="Horizontal" Gap="xs" Margin="{t:Sp '0,s,0,0'}">
                                                <Button Content="{t:T 'Use Ollama'}" Style="{StaticResource CompactButton}" Click="OnUseOllama" />
                                                <Button Content="{t:T 'Use LM Studio'}" Style="{StaticResource CompactButton}" Click="OnUseLmStudio" />
                                            </c:SpacedStack>
                                            <TextBlock x:Name="LocalAddressError" Style="{StaticResource ErrorText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </c:Unit>
                                    <c:Unit Title="{t:T 'Model name'}"
                                            Hint="{t:T 'Type the model name as the server shows it. In Ollama, download it first: ollama pull qwen2.5:7b (downloaded models: ollama list). In LM Studio, load the model and start the local server.'}">
                                        <TextBox x:Name="LocalModel" LostFocus="OnLocalChanged" KeyDown="OnLocalKey" />
                                    </c:Unit>
                                    <TextBlock x:Name="LocalKeyLabel" Text="{t:T 'API key (optional)'}" Style="{StaticResource UnitTitleText}" />
                                </c:SpacedStack>
                                <StackPanel x:Name="NewKey">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="KeyBox" />
                                        <Button x:Name="KeySave" Grid.Column="1" Content="{t:T 'Save and test'}" Margin="{t:Sp 's,0,0,0'}" Click="OnKeySave" />
                                    </Grid>
                                    <TextBlock x:Name="NoKeyHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'Add your key to start. Until then the free translation is used.'}" />
                                    <TextBlock Margin="{t:Sp '0,titleBody,0,0'}" FontSize="{DynamicResource smallFontSize}">
                                        <Hyperlink x:Name="KeyLink" RequestNavigate="OnLink"><Run x:Name="KeyLinkText" /></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <DockPanel x:Name="SavedKey" LastChildFill="False">
                                    <TextBlock Text="{t:T 'Key saved'}" Style="{StaticResource DoneText}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="{t:T 'Remove key'}" Style="{StaticResource CompactButton}" Margin="{t:Sp 'xs,0,0,0'}" Click="OnKeyRemove" />
                                    <Button x:Name="KeyTest" DockPanel.Dock="Right" Content="{t:T 'Test'}" Style="{StaticResource CompactButton}" Click="OnKeyTest" />
                                </DockPanel>
                                <TextBlock x:Name="KeyStatus" Style="{StaticResource HintText}" Visibility="Collapsed" />
                                <TextBlock x:Name="KeyError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <!-- Ek talimat (#306): yapay zekâ çevirmeninin talimatının sonuna eklenir; alandan çıkınca kaydedilir (Mac ile aynı). -->
                                <c:Unit x:Name="InstructionPanel" Title="{t:T 'Extra instruction'}" Visibility="Collapsed"
                                        Hint="{t:T 'Added to the end of the AI translator\'s instructions (up to 1000 characters). Leave it empty if you don\'t need it.'}">
                                    <Grid>
                                        <TextBox x:Name="Instruction" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                                 VerticalScrollBarVisibility="Auto" MaxLength="1000"
                                                 LostFocus="OnInstructionChanged" TextChanged="OnInstructionTyped" />
                                        <TextBlock x:Name="InstructionPlaceholder" Style="{StaticResource HintText}" IsHitTestVisible="False"
                                                   Margin="{t:Sp 'm,s,m,0'}"
                                                   Text="{t:T 'Example: Translate swear words without softening them.'}" />
                                    </Grid>
                                </c:Unit>
                            </c:SpacedStack>
                        </c:SpacedStack>
                    </c:Card>
                    <c:SpacedStack Grid.Column="2" Gap="l">
                        <!-- Ekran yazıları: Mac, iPhone, Android ile aynı başlık, ad ve sıra. -->
                        <c:Card Title="{t:T 'On-screen text'}">
                            <c:SpacedStack>
                                <c:SwitchRow x:Name="AutoScreenText" Content="{t:T 'Translate On-Screen Text Automatically'}"
                                             Description="{t:T 'Objectives, menus and other text on the screen.'}"
                                             Checked="OnAutoScreenText" Unchecked="OnAutoScreenText" />
                                <!-- Otomatik ekran yazısının türleri: yalnız ayar açıkken görünür; dört platformda aynı ad ve sıra (bkz. ScreenTextKind).
                                     Telefon türü ayrı satır değil: tek "GTA 6 Telefonunu Çevir" anahtarı onu da yazar (TranslatesGamePhone). -->
                                <c:Unit x:Name="ScreenTextKindsPanel" Title="{t:T 'Which on-screen text to translate'}" Hint="{t:T 'Translate the screen always translates everything.'}">
                                    <c:SpacedStack Gap="xs">
                                        <CheckBox x:Name="ScreenTextMission" Content="{t:T 'Mission and objective text'}" Checked="OnScreenTextKind" Unchecked="OnScreenTextKind" />
                                        <CheckBox x:Name="ScreenTextHelp" Content="{t:T 'Help boxes and actions (button prompts)'}" Checked="OnScreenTextKind" Unchecked="OnScreenTextKind" />
                                        <CheckBox x:Name="ScreenTextMenus" Content="{t:T 'Menus (pause, map, settings)'}" Checked="OnScreenTextKind" Unchecked="OnScreenTextKind" />
                                        <CheckBox x:Name="ScreenTextBeside" Content="{t:T 'Write the translation beside menu text'}" Checked="OnScreenTextKind" Unchecked="OnScreenTextKind" />
                                        <CheckBox x:Name="ScreenTextOther" Content="{t:T 'Other on-screen text'}" Checked="OnScreenTextKind" Unchecked="OnScreenTextKind" />
                                    </c:SpacedStack>
                                </c:Unit>
                                <c:SwitchRow x:Name="AutoReadGamePhone" Content="{t:T 'Translate the GTA 6 Phone'}"
                                             Description="{t:T 'Each message is translated over its own bubble.'}"
                                             Checked="OnAutoReadGamePhone" Unchecked="OnAutoReadGamePhone" />
                                <c:SwitchRow x:Name="SetTextApart" Content="{t:T 'Set On-Screen Text Apart from Subtitles'}"
                                             Description="{t:T 'On-screen text keeps its own colours and place, and never looks like the subtitle box.'}"
                                             Checked="OnSetTextApart" Unchecked="OnSetTextApart" />
                                <!-- GTA 6 telefon mesajları (otomatik okuma ve "Ekranı çevir"): Yanda Panel (varsayılan) ya da Balonların Üstünde;
                                     Mac, iPhone, Android ile aynı ad ve seçenekler. -->
                                <c:Unit Title="{t:T 'GTA 6 Phone Messages'}"
                                        Hint="{t:T 'Side Panel: the chat is shown next to the phone, the other person on the left and you on the right. On the Bubbles: each message is translated on top of its own bubble.'}">
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="PhoneMessagesPanel" Content="{t:T 'Side Panel'}" GroupName="phoneMessages" Style="{StaticResource SegmentButton}" Checked="OnPhoneMessages" />
                                            <RadioButton x:Name="PhoneMessagesBubbles" Content="{t:T 'On the Bubbles'}" GroupName="phoneMessages" Style="{StaticResource SegmentButton}" Checked="OnPhoneMessages" />
                                        </UniformGrid>
                                    </Border>
                                </c:Unit>
                                <Button Content="{t:T 'Restore Defaults'}" Style="{StaticResource CompactButton}" Click="OnScreenTextDefaults" />
                            </c:SpacedStack>
                        </c:Card>
                        <!-- Altyazı okuma: yazı tanıma, sık okuma ve kötü okunan satırların bekleme süreleri (SubtitlePipeline.PackWait / CleanWait). -->
                        <c:Card Title="{t:T 'Subtitle reading'}">
                            <c:SpacedStack>
                                <!-- Yazı tanıma: Windows'unki ya da gelişmiş (PP-OCRv6, PaddleOcrReader). -->
                                <c:Unit x:Name="OcrEnginePanel" Title="{t:T 'Text recognition'}">
                                    <StackPanel>
                                        <ComboBox x:Name="OcrEngineChoice" SelectionChanged="OnOcrEngine">
                                            <ComboBoxItem Content="{t:T 'Windows (default)'}" Tag="Windows" />
                                            <ComboBoxItem Content="{t:T 'Advanced · reads bright scenes better'}" Tag="Advanced" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                                   Text="{t:T 'Advanced recognition reads white subtitles on bright scenes (sky, snow, daylight) much better. It runs on your graphics card, or on the CPU when there is none, and uses more of it than the Windows recognition. The model is downloaded once (31 MB).'}" />
                                        <StackPanel x:Name="AdvancedOcrDownload" Margin="{t:Sp '0,s,0,0'}" Visibility="Collapsed">
                                            <Button x:Name="AdvancedOcrDownloadButton" Content="{t:T 'Download the model'}" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Click="OnDownloadAdvancedOcr" />
                                            <ProgressBar x:Name="AdvancedOcrProgress" Maximum="1" Margin="{t:Sp '0,s,0,0'}" Visibility="Collapsed" />
                                            <TextBlock x:Name="AdvancedOcrProgressText" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="AdvancedOcrError" Style="{StaticResource ErrorText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed" />
                                    </StackPanel>
                                </c:Unit>
                                <c:SwitchRow x:Name="FastSubtitleDetection" Content="{t:T 'Check Unchanged Subtitle Areas More Often'}"
                                             Description="{t:T 'When the subtitle area looks unchanged, read it again after 2 frames instead of 20. Uses more CPU.'}"
                                             Checked="OnFastSubtitleDetection" Unchecked="OnFastSubtitleDetection" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{t:T 'These waits only delay lines that were read badly; most lines are shown without waiting. A shorter wait shows those lines sooner but lets more wrong translations through.'}" />
                                <!-- Kaydırıcı birimi: başlık solda, değer sağda (mono); çubuk altta; açıklama en altta. -->
                                <StackPanel>
                                    <DockPanel Margin="{t:Sp '0,0,0,unitTitle'}">
                                        <TextBlock x:Name="MisreadWaitValue" DockPanel.Dock="Right" Style="{StaticResource SliderValueText}" />
                                        <TextBlock Text="{t:T 'Wait for a Misread Line'}" Style="{StaticResource UnitTitleText}" />
                                    </DockPanel>
                                    <Slider x:Name="MisreadWait" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True" ValueChanged="OnMisreadWait" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'When a line is read with words that are not in the dictionary, a better reading is awaited for at most this long. Measured in GTA V, translations from misread lines compared with 0 s: 0.2 s → 77%, 0.4 s → 49%, 0.6 s → 41%, 0.8 s (recommended) → 34%, 1.0 s → 31%.'}" />
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel Margin="{t:Sp '0,0,0,unitTitle'}">
                                        <TextBlock x:Name="PartialWaitValue" DockPanel.Dock="Right" Style="{StaticResource SliderValueText}" />
                                        <TextBlock Text="{t:T 'Wait for a half-read line'}" Style="{StaticResource UnitTitleText}" />
                                    </DockPanel>
                                    <Slider x:Name="PartialWait" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True" ValueChanged="OnPartialWait" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'When a line looks cut off (no sentence ending, such as a mission text with a colored word), the full line is awaited for at most this long. Its effect is small: at 0 s a few more lines arrive cut off. Recommended: 0.3 s.'}" />
                                </StackPanel>
                                <Button Content="{t:T 'Restore Defaults'}" Style="{StaticResource CompactButton}" Click="OnWaitDefaults" />
                            </c:SpacedStack>
                        </c:Card>
                    </c:SpacedStack>
                </Grid>
            </TabItem>

            <!-- ───── Altyazı Alanı ───── -->
            <TabItem x:Name="AreaTab">
                <c:SpacedStack Gap="l" Margin="{t:Sp '0,0,0,l'}">
                    <Grid c:Responsive.StackBelow="{x:Static c:Responsive.TwoColumnMin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{t:Sp l}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Oyuna göre alanlar: alanlar oynanan oyuna kaydedilir, o oyun yeniden oynanınca kendiliğinden gelir -->
                        <c:Card Title="{t:T 'Areas for this game'}">
                            <c:SpacedStack>
                                <StackPanel>
                                    <TextBlock x:Name="AreaProfileText" Foreground="{DynamicResource textPrimaryBrush}" />
                                    <TextBlock x:Name="AreaProfileHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,titleBody,0,0'}" />
                                </StackPanel>
                                <c:SpacedStack x:Name="AreaProfileButtons" Orientation="Horizontal" Gap="xs">
                                    <Button x:Name="AreaProfileSave" Style="{StaticResource CompactButton}" Click="OnSaveAreaProfile" />
                                    <Button x:Name="AreaProfileDelete" Content="{t:T 'Delete profile'}" Style="{StaticResource CompactButton}" Click="OnDeleteAreaProfile" />
                                </c:SpacedStack>
                            </c:SpacedStack>
                        </c:Card>
                        <!-- Oyun profilleri: her oyunun kendi alanları; listede olmayan oyun adı yazılarak eklenir -->
                        <c:Card Grid.Column="2" Title="{t:T 'Game profiles'}">
                            <c:SpacedStack>
                                <!-- Metin kodda verilir (kesme işareti biçimlendirme ifadesine sığmıyor). -->
                                <TextBlock x:Name="GameProfilesHint" Style="{StaticResource HintText}" />
                                <StackPanel x:Name="GameProfileList" />
                                <c:Unit x:Name="GameProfileEditor" Title="{t:T 'Game name'}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBox x:Name="GameProfileName" KeyDown="OnGameProfileNameKey" />
                                        <TextBlock x:Name="GameProfileProblem" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed" />
                                        <c:SpacedStack Orientation="Horizontal" Gap="xs" Margin="{t:Sp '0,s,0,0'}">
                                            <Button x:Name="GameProfileCommit" Style="{StaticResource CompactButton}" Click="OnCommitGameProfile" />
                                            <Button Content="{t:T 'Cancel'}" Style="{StaticResource CompactButton}" Click="OnCancelGameProfile" />
                                        </c:SpacedStack>
                                    </StackPanel>
                                </c:Unit>
                                <Button x:Name="GameProfileNew" Content="{t:T 'New game profile'}" Style="{StaticResource CompactButton}"
                                        HorizontalAlignment="Left" Click="OnNewGameProfile" />
                            </c:SpacedStack>
                        </c:Card>
                    </Grid>
                    <c:Card Title="{t:T 'Subtitle area'}">
                        <c:SpacedStack>
                            <!-- Altyazı alanı ve adlı ek alanlar (en çok üç; Mac'teki ek alan listesiyle aynı). Sekmeler koddan kurulur. -->
                            <WrapPanel>
                                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="{t:Sp '0,0,xs,0'}">
                                    <StackPanel x:Name="AreaTabs" Orientation="Horizontal" />
                                </Border>
                                <Button x:Name="AddAreaButton" Content="{t:T 'Add extra area'}" Style="{StaticResource CompactButton}" VerticalAlignment="Center" Click="OnAddArea">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{t:T 'Quest (top right)'}" Tag="Quest" Click="OnAddAreaPreset" />
                                            <MenuItem Header="{t:T 'Notification (bottom left)'}" Tag="Notification" Click="OnAddAreaPreset" />
                                            <MenuItem Header="{t:T 'Phone (bottom right)'}" Tag="Phone" Click="OnAddAreaPreset" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <!-- Altyazı bölgesinin hazır seçimleri; Özel'de dikey konum ve yükseklik kaydırıcıları -->
                            <c:SpacedStack x:Name="PresetPanel">
                                <c:Unit Title="{t:T 'Area preset'}">
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="PresetBottom" Content="{t:T 'Bottom area'}" GroupName="preset" Style="{StaticResource SegmentButton}" Checked="OnPreset" Tag="Bottom" />
                                            <RadioButton x:Name="PresetTop" Content="{t:T 'Top area'}" GroupName="preset" Style="{StaticResource SegmentButton}" Checked="OnPreset" Tag="Top" />
                                            <RadioButton x:Name="PresetFull" Content="{t:T 'Full screen'}" GroupName="preset" Style="{StaticResource SegmentButton}" Checked="OnPreset" Tag="Full" />
                                            <RadioButton x:Name="PresetCustom" Content="{t:T 'Custom'}" GroupName="preset" Style="{StaticResource SegmentButton}" Checked="OnPreset" Tag="Custom" />
                                        </UniformGrid>
                                    </Border>
                                </c:Unit>
                                <c:SpacedStack x:Name="CustomPanel">
                                    <StackPanel>
                                        <DockPanel Margin="{t:Sp '0,0,0,unitTitle'}">
                                            <TextBlock x:Name="VerticalPositionValue" DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{t:T 'Vertical position'}" Style="{StaticResource UnitTitleText}" />
                                        </DockPanel>
                                        <Slider x:Name="VerticalPosition" Minimum="0" Maximum="95" SmallChange="1" LargeChange="5"
                                                IsMoveToPointEnabled="True" ValueChanged="OnVertical" />
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel Margin="{t:Sp '0,0,0,unitTitle'}">
                                            <TextBlock x:Name="AreaHeightValue" DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{t:T 'Height'}" Style="{StaticResource UnitTitleText}" />
                                        </DockPanel>
                                        <Slider x:Name="AreaHeight" Minimum="5" Maximum="100" SmallChange="1" LargeChange="5"
                                                IsMoveToPointEnabled="True" ValueChanged="OnVertical" />
                                    </StackPanel>
                                </c:SpacedStack>
                                <!-- Ortada tut: kenar çekilince karşı kenar da oynar; sola yaslı ya da köşedeki altyazıda kapatılır -->
                                <c:SwitchRow x:Name="KeepCentered" Content="{t:T 'Keep centered'}" Checked="OnKeepCentered" Unchecked="OnKeepCentered" />
                            </c:SpacedStack>
                            <!-- Ek alanın adı ve kaldırma düğmesi -->
                            <c:Unit x:Name="ExtraNamePanel" Title="{t:T 'Area name'}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExtraName" TextChanged="OnAreaName" />
                                    <Button Grid.Column="1" Content="{t:T 'Remove'}" Style="{StaticResource CompactButton}" Margin="{t:Sp 's,0,0,0'}" VerticalAlignment="Center" Click="OnRemoveArea" />
                                </Grid>
                            </c:Unit>
                            <!-- Ek bölge tuşa basmadan da sürekli okunur (görev, telefon, bildirim); hazır köşe seçimleri -->
                            <StackPanel x:Name="ExtraLivePanel" Visibility="Collapsed">
                                <c:SwitchRow x:Name="ExtraLive" Content="{t:T 'Keep reading this area'}"
                                             Description="{t:T 'While translating, this area is read about once a second. Its translation shows where the subtitles show, next to the original text, until the text changes.'}"
                                             Checked="OnExtraLive" Unchecked="OnExtraLive" />
                                <!-- Tam ekranda sürekli okuma durur; metin kodda verilir (bkz. ShowExtraFullScreenHint). -->
                                <TextBlock x:Name="ExtraFullScreenHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" Visibility="Collapsed" />
                                <WrapPanel Margin="{t:Sp '0,s,0,0'}">
                                    <Button Content="{t:T 'Quest (top right)'}" Style="{StaticResource CompactButton}" Tag="Quest" Click="OnExtraPreset" Margin="{t:Sp '0,0,xs,xs'}" />
                                    <Button Content="{t:T 'Notification (bottom left)'}" Style="{StaticResource CompactButton}" Tag="Notification" Click="OnExtraPreset" Margin="{t:Sp '0,0,xs,xs'}" />
                                    <Button Content="{t:T 'Phone (bottom right)'}" Style="{StaticResource CompactButton}" Tag="Phone" Click="OnExtraPreset" Margin="{t:Sp '0,0,0,xs'}" />
                                </WrapPanel>
                            </StackPanel>
                            <c:Unit x:Name="ExtraTargetPanel" Title="{t:T 'Show the result'}" Visibility="Collapsed">
                                <Border Style="{StaticResource SegmentGroup}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="ExtraTv" Content="{t:T 'On the TV'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Tv" />
                                        <RadioButton x:Name="ExtraPc" Content="{t:T 'On the PC'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Pc" />
                                        <RadioButton x:Name="ExtraBoth" Content="{t:T 'On both'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Both" />
                                    </UniformGrid>
                                </Border>
                            </c:Unit>
                            <StackPanel>
                                <c:RegionPicker x:Name="Region" RegionChanged="OnRegion" />
                                <Button x:Name="RefreshButton" Click="OnRefresh" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Margin="{t:Sp '0,s,0,0'}" />
                                <TextBlock x:Name="AreaHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}" />
                            </StackPanel>
                        </c:SpacedStack>
                    </c:Card>
                    <c:Card x:Name="ScreenCard">
                        <TextBlock x:Name="ScreenHint" Style="{StaticResource HintText}" />
                    </c:Card>
                    <c:Card x:Name="FreeAreaCard">
                        <c:SpacedStack>
                            <TextBlock x:Name="FreeAreaHint" Style="{StaticResource HintText}" />
                            <c:Unit Title="{t:T 'Show the result'}">
                                <Border Style="{StaticResource SegmentGroup}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="FreeTv" Content="{t:T 'On the TV'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Tv" />
                                        <RadioButton x:Name="FreePc" Content="{t:T 'On the PC'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Pc" />
                                        <RadioButton x:Name="FreeBoth" Content="{t:T 'On both'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Both" />
                                    </UniformGrid>
                                </Border>
                            </c:Unit>
                            <StackPanel>
                                <TextBlock x:Name="PauseHint" Style="{StaticResource HintText}" />
                                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,titleBody,0,0'}"
                                           Text="{t:T 'The shortcuts work only while translating, so the keys stay free in other apps. Keep Num Lock on for the Num keys. You can change them under Keyboard shortcuts.'}" />
                            </StackPanel>
                        </c:SpacedStack>
                    </c:Card>
                </c:SpacedStack>
            </TabItem>

            <!-- ───── Oyun Paketleri ───── -->
            <TabItem x:Name="PacksSection">
                <c:SpacedStack Gap="l" Margin="{t:Sp '0,0,0,l'}">
                    <DockPanel>
                        <c:Chip x:Name="PacksPill" DockPanel.Dock="Right" Tone="Amber" VerticalAlignment="Top" Margin="{t:Sp 's,0,0,0'}" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="{t:T 'Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine.'}" />
                    </DockPanel>
                    <c:SpacedStack Orientation="Horizontal" Gap="s">
                        <Button x:Name="ImportPack" Content="{t:T 'Import pack…'}" Click="OnImportPack" />
                        <!-- Telefonlardaki "Paketleri şimdi güncelle": beklerken düğme "Güncelleniyor…", sonuç iletide. -->
                        <Button x:Name="UpdatePacks" Content="{t:T 'Update the packs now'}" Click="OnUpdatePacks" />
                        <c:BarsLoader x:Name="UpdatePacksProgress" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdatePacksStatus" Text="{t:T 'Updating the packs…'}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </c:SpacedStack>
                    <!-- Kapak rafı (Perde): her paket 3:4 kapak (seçilen görsel ya da adından degrade) + satır sayısı; oynanan
                         oyunun kapağı amber halka ve kapak ışımasıyla. Tıklayınca kapak seçilir, sağ tıkta seç/kaldır. -->
                    <ItemsControl x:Name="PackList" Margin="{t:Sp 'xxs,0,0,0'}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- Oyun paketleri ve ortak havuz anahtarları: her biri bir anahtar birimi; aralar 24, ayraç yok. -->
                    <c:Card>
                        <c:SpacedStack>
                            <c:SwitchRow x:Name="GamePacks" Content="{t:T 'Use game packs'}" Checked="OnGamePacks" Unchecked="OnGamePacks" />
                            <c:SwitchRow x:Name="SharePool" Content="{t:T 'Send the English subtitles read to the shared pool'}"
                                         Description="{t:T 'Only the game\'s English text is sent, anonymously. It is used to make better Turkish translations for everyone.'}"
                                         Checked="OnSharePool" Unchecked="OnSharePool" />
                            <!-- Kullanım verisi: telefonlardaki Profil › Kullanım verisi ile aynı ad ve açıklama; ölçüm yoksa gizli. -->
                            <StackPanel x:Name="UsageDataRow">
                                <c:SwitchRow x:Name="UsageData" Content="{t:T 'Usage data'}" Description="{t:T 'Error and usage statistics'}"
                                             Checked="OnUsageData" Unchecked="OnUsageData" />
                            </StackPanel>
                            <c:SwitchRow x:Name="AskGame" Content="{t:T 'Ask which game I\'m playing'}"
                                         Description="{t:T 'If no pack recognises the game, asked once two minutes after translation starts.'}"
                                         Checked="OnAskGame" Unchecked="OnAskGame" />
                            <c:SwitchRow x:Name="SpeakerNames" Content="{t:T 'Show speaker name'}"
                                         Description="{t:T 'Keeps the character\'s name in front of the translation (ARTHUR: …). The name itself is never translated.'}"
                                         Checked="OnSpeakerNames" Unchecked="OnSpeakerNames" />
                            <c:SwitchRow x:Name="SpeakerColors" Content="{t:T 'Color speaker names'}"
                                         Description="{t:T 'Only the speaker\'s name gets its own color; the line stays in your Text color.'}"
                                         Checked="OnSpeakerColors" Unchecked="OnSpeakerColors" />
                            <c:SwitchRow x:Name="GameAreaPresets" Content="{t:T 'Use ready areas for known games'}"
                                         Description="{t:T 'When a game with ready areas (such as GTA 6) is being played, its help box and messages are read and translated automatically. Your own extra areas take precedence.'}"
                                         Checked="OnGameAreaPresets" Unchecked="OnGameAreaPresets" />
                        </c:SpacedStack>
                    </c:Card>
                </c:SpacedStack>
            </TabItem>

            <!-- ───── Türkçe Seslendirme ───── -->
            <TabItem x:Name="DubbingSection">
                <StackPanel Margin="{t:Sp '0,0,0,l'}">
                    <local:DubbingCard x:Name="Dubbing" />
                </StackPanel>
            </TabItem>

            <!-- ───── Çıkış Ekranları ───── -->
            <TabItem x:Name="OutputSection">
                <Grid Margin="{t:Sp '0,0,0,l'}" c:Responsive.StackBelow="{x:Static c:Responsive.TwoColumnMin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{t:Sp l}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SpacedStack Gap="l">
                        <local:SubtitleOutputCard x:Name="OutputCard" Detailed="True" />
                        <!-- TV durumu: bağlıyken "Bağlı", koptuysa bir dakika "Yeniden bağlanılıyor…" (TV alındısı), sonra bekleniyor. -->
                        <c:Card Title="TV" Visibility="{Binding ShowsOnTv, Converter={StaticResource VisibleIf}}">
                            <c:SpacedStack>
                                <!-- Perde TV kartı: simge karesi, ad + mono "Marka · adres", sağda "Eşli" hapı (bağlıyken yeşil, kart
                                     amber kenarlı); altında durum cümlesi. -->
                                <StackPanel>
                                    <ContentControl x:Name="TvCardHost" Focusable="False" />
                                    <StackPanel Orientation="Horizontal" Margin="{t:Sp '0,s,0,0'}">
                                        <Ellipse x:Name="TvStatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="{t:Sp '0,0,xs,0'}" />
                                        <TextBlock Text="{Binding TvStatusText}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Süren iş (kendiliğinden başlayan TV uygulaması güncellemesi dahil) ve hangi adımda olunduğu;
                                         biten işin kısa süre görünen sonucu ya da açık hata (Mac ile aynı). -->
                                    <StackPanel x:Name="TvProgressPanel" Orientation="Horizontal" Margin="{t:Sp '0,xs,0,0'}" Visibility="Collapsed">
                                        <c:BarsLoader VerticalAlignment="Center" Margin="{t:Sp '0,0,xs,0'}" />
                                        <TextBlock x:Name="TvProgressText" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TvStepLine" Style="{StaticResource HintText}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock x:Name="TvOutcomeOk" Foreground="{DynamicResource successBrush}" Margin="{t:Sp '0,xs,0,0'}" Visibility="Collapsed" />
                                    <c:Callout x:Name="TvOutcomeError" Tone="Attention" Margin="{t:Sp '0,xs,0,0'}" Visibility="Collapsed" />
                                </StackPanel>
                                <!-- Düğmeler TV'nin durumuna göre: eşli değilse "TV'yi Eşleştir", eşli ama TV uygulaması bağlı değilse
                                     "TV'de CouchSubs'ı Aç", bağlıyken eşleştirme düğmesi yok (önceden eşli ve bağlı TV'de de duruyordu). -->
                                <WrapPanel>
                                    <Button x:Name="TestTvButton" Content="{t:T 'Send Test Subtitle'}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnTest" />
                                    <Button x:Name="PairTvButton" Content="{t:T 'Pair the TV'}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnPairTv" />
                                    <Button x:Name="OpenTvAppButton" Content="{t:T 'Open CouchSubs on the TV'}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnOpenTvApp" />
                                    <Button Content="{t:T 'Renew access key'}" Margin="{t:Sp '0,0,0,xs'}" Click="OnRenewAccessKey" />
                                </WrapPanel>
                                <!-- Eşli TV her zaman değiştirilebilir ve kaldırılabilir (Mac/iPhone/Android ile aynı); önceden eşli TV'nin
                                     adresi değişince kart "TV uygulaması bekleniyor"da kalıyor, TV ne değiştirilebiliyor ne kaldırılabiliyordu. -->
                                <WrapPanel x:Name="PairedTvActions" Visibility="{Binding HasTv, Converter={StaticResource VisibleIf}}">
                                    <Button Content="{t:T 'Change the TV'}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnChangeTv" />
                                    <Button Content="{t:T 'Remove Pairing'}" Margin="{t:Sp '0,0,0,xs'}" Click="OnRemoveTvPairing" />
                                </WrapPanel>
                                <!-- "TV'yi Eşleştir" ya da "Deneme Altyazısı Gönder" TV'ye ulaşamadı: ne olduğu ve iki çözüm. -->
                                <c:SpacedStack x:Name="TvUnreachablePanel" Gap="xs" Visibility="Collapsed">
                                    <c:Callout x:Name="TvUnreachableBox" Tone="Attention" />
                                    <WrapPanel>
                                        <Button Content="{t:T 'Search for the TV Again'}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnSearchTvAgain" />
                                        <Button Content="{t:T 'Enter IP Address'}" Margin="{t:Sp '0,0,0,xs'}" Click="OnEnterTvAddress" />
                                    </WrapPanel>
                                    <Grid x:Name="TvAddressPanel" Visibility="Collapsed">
                                        <TextBox x:Name="TvAddress" FontFamily="{StaticResource MonoFont}" Padding="{t:Sp 'm,0,xxl,0'}" KeyDown="OnTvAddressKey"
                                                 ToolTip="{t:T 'IP address, e.g. 192.168.1.20'}" />
                                        <Button Content="{t:T 'Add'}" Style="{StaticResource CompactButton}" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="{t:Sp '0,0,xs,0'}" Click="OnUseTvAddress" />
                                    </Grid>
                                </c:SpacedStack>
                                <c:Callout x:Name="LegacyTvWarning" Text="{t:T 'The TV app is old. Update it.'}" Visibility="Collapsed" />
                            </c:SpacedStack>
                        </c:Card>
                        <!-- Yer ve biçim (Mac Çıkış Ekranları › AppearanceCard, başlıksız kart): yazı boyutu, zemin ve renkler Altyazı
                             Görünümü'nde; burada yer, zemin alanı, kalın yazı, önceki satırlar ve Android TV görüntü modu kalır. -->
                        <c:Card x:Name="StyleCard">
                            <c:SpacedStack>
                                <!-- Yazı boyutu, zemin ve yazı rengi artık düzenleyicide (AppearanceEditor); bu birimler gizli kalır, ayarın kendisi aynı. -->
                                <c:Unit x:Name="TextSizeUnit" Title="{t:T 'Text size'}">
                                    <StackPanel>
                                        <!-- Sürüklerken TV'de örnek altyazı görünür; boyut doğrudan ekranda ayarlanır. -->
                                        <Slider x:Name="TextSize" Minimum="16" Maximum="50" SmallChange="1" LargeChange="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                ValueChanged="OnTextSize" PreviewMouseDown="OnPositionStart" />
                                        <TextBlock x:Name="TextSizeValue" Style="{StaticResource SliderRangeText}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </c:Unit>
                                <!-- Yer ayarları TV içindir; bilgisayar ekranındaki altyazı penceresi sürüklenerek taşınır (2026-11-13). -->
                                <c:SpacedStack x:Name="TvPlacementPanel">
                                    <c:Unit Title="{t:T 'Placement'}">
                                        <StackPanel>
                                            <ComboBox x:Name="Placement" SelectionChanged="OnPlacement">
                                                <ComboBoxItem Content="{t:T 'Over the English subtitle'}" Tag="Cover" />
                                                <ComboBoxItem Content="{t:T 'Above the English subtitle'}" Tag="Above" />
                                                <ComboBoxItem Content="{t:T 'Below the English subtitle'}" Tag="Below" />
                                                <ComboBoxItem Content="{t:T 'Fixed position'}" Tag="Fixed" />
                                            </ComboBox>
                                            <TextBlock x:Name="FollowsHint" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                                       Text="{t:T 'The translation follows where the game shows its own subtitle.'}" />
                                        </StackPanel>
                                    </c:Unit>
                                    <c:Unit x:Name="FixedPanel" Title="{t:T 'Position on screen'}"
                                            Hint="{t:T 'In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote.'}">
                                        <StackPanel>
                                            <!-- Sürüklerken TV'de örnek altyazı görünür; böylece yer doğrudan ekranda ayarlanır. -->
                                            <Slider x:Name="Position" Minimum="0" Maximum="85" IsMoveToPointEnabled="True"
                                                    ValueChanged="OnPosition" PreviewMouseDown="OnPositionStart" />
                                            <DockPanel Style="{StaticResource SliderRange}">
                                                <TextBlock Text="{t:T 'Bottom'}" Style="{StaticResource SliderRangeText}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{t:T 'Top'}" Style="{StaticResource SliderRangeText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </c:Unit>
                                </c:SpacedStack>
                                <c:Unit x:Name="ComputerPlacementPanel"
                                        Hint="{t:T 'On the computer screen, move and resize the subtitle with the mouse: press Position the subtitles.'}">
                                    <Button HorizontalAlignment="Left" Content="{t:T 'Position the subtitles'}" Click="OnAdjustOverlay" />
                                </c:Unit>
                                <c:Unit x:Name="BackgroundUnit" Title="{t:T 'Background'}">
                                    <StackPanel>
                                        <Slider x:Name="BackgroundOpacity" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                                ValueChanged="OnBackground" PreviewMouseDown="OnPositionStart" />
                                        <DockPanel Style="{StaticResource SliderRange}">
                                            <TextBlock Text="{t:T 'None'}" Style="{StaticResource SliderRangeText}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{t:T 'Solid'}" Style="{StaticResource SliderRangeText}" />
                                        </DockPanel>
                                    </StackPanel>
                                </c:Unit>
                                <c:Unit Title="{t:T 'Background area'}"
                                        Hint="{t:T 'A full-width band also covers the sides of the English subtitle.'}">
                                    <ComboBox x:Name="BackgroundShape" SelectionChanged="OnBackgroundShape">
                                        <ComboBoxItem Content="{t:T 'Fit the text'}" Tag="Fit" />
                                        <ComboBoxItem Content="{t:T 'Full-width band'}" Tag="Band" />
                                    </ComboBox>
                                </c:Unit>
                                <c:SwitchRow x:Name="Bold" Content="{t:T 'Bold text'}" Checked="OnBold" Unchecked="OnBold" />
                                <c:SwitchRow x:Name="StackPrevious" Content="{t:T 'Keep previous lines above in fast dialogue'}"
                                             Description="{t:T 'When off, each new line replaces the previous one. Needs TV app 0.9.16 or later.'}"
                                             Checked="OnStackPrevious" Unchecked="OnStackPrevious" />
                                <c:Unit x:Name="TextColorUnit" Title="{t:T 'Text color'}">
                                    <ComboBox x:Name="TextColor" SelectionChanged="OnTextColor">
                                        <ComboBoxItem Content="{t:T 'White'}" Tag="White" />
                                        <ComboBoxItem Content="{t:T 'Yellow'}" Tag="Yellow" />
                                    </ComboBox>
                                </c:Unit>
                                <!-- Yalnız Android TV: bazı TV'lerde (ör. TCL) uygulama içindeki PS5 görüntüsü siyah kalıyor. -->
                                <c:Unit x:Name="DisplayModePanel" Title="{t:T 'Picture mode'}" Visibility="Collapsed"
                                        Hint="{t:T 'Automatic uses Overlay whenever the TV app allows it: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. On some TVs the picture stays black inside the CouchSubs TV app. To show the PS5 inside the CouchSubs TV app instead, choose Inside the app; the TV app then never switches to Overlay by itself: if no picture arrives, it reopens the HDMI input and lists the inputs, and you can choose Overlay there. With Overlay the TV also keeps its picture mode, Game mode and HDR. The TV app from Google Play has no Overlay mode: there Automatic stays inside the app, and the TV says so on screen if Overlay is chosen.'}">
                                    <ComboBox x:Name="DisplayMode" SelectionChanged="OnDisplayMode">
                                        <ComboBoxItem Content="{t:T 'Automatic (recommended)'}" Tag="Auto" />
                                        <ComboBoxItem Content="{t:T 'Inside the app'}" Tag="InAppOnly" />
                                        <ComboBoxItem Content="{t:T 'Overlay (for a black screen)'}" Tag="Overlay" />
                                    </ComboBox>
                                </c:Unit>
                            </c:SpacedStack>
                        </c:Card>
                        <!-- TV uygulamasının kurulum/durum kartları; yapılacak bir şey yoksa kendisi gizlenir. Kartın içine
                             konmaz: beta.104'te kendi kartları gizliyken dış kart "Hızlı konuşmada…" ile "Yayın penceresi"
                             arasında boş kalıyordu (Android TV, uygulama güncel). -->
                        <s:TvAppCard Shown="{Binding ShowsOnTv}" />
                        <!-- Şeffaflık tanımayan yayın programları için düz zeminli altyazı penceresi (StreamWindow.cs). -->
                        <c:Card Title="{t:T 'Stream window'}">
                            <c:SpacedStack>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{t:T 'For streaming apps without a transparent browser source (TikTok LIVE Studio, Streamlabs and others): open the stream window, add it with Window capture (the window is called CouchSubs Stream) and remove its background with a Chroma key filter.'}" />
                                <c:Unit Title="{t:T 'Background'}">
                                    <ComboBox x:Name="StreamBackgroundChoice" SelectionChanged="OnStreamBackground">
                                        <ComboBoxItem Content="{t:T 'Green'}" Tag="Green" />
                                        <ComboBoxItem Content="{t:T 'Black'}" Tag="Black" />
                                        <ComboBoxItem Content="{t:T 'Magenta'}" Tag="Magenta" />
                                    </ComboBox>
                                </c:Unit>
                                <c:Unit Hint="{t:T 'Keep the window open and uncovered while streaming. Subtitles appear in it while the translation is running, even when they are shown only on the TV.'}">
                                    <Button x:Name="StreamWindowToggle" Content="{t:T 'Open the stream window'}" HorizontalAlignment="Left" Click="OnOpenStreamWindow" />
                                </c:Unit>
                            </c:SpacedStack>
                        </c:Card>
                        <local:FirewallSettingsCard x:Name="FirewallSettings" />
                    </c:SpacedStack>
                    <c:SpacedStack Grid.Column="2" Gap="l">
                        <c:Card Title="{t:T 'Show on another device'}">
                            <local:SecondScreenPanel x:Name="SecondScreenCard" />
                        </c:Card>
                        <c:Card Title="OBS">
                            <c:SpacedStack>
                                <c:Unit Hint="{t:T 'If OBS runs on another computer, use the network address of this PC instead of localhost. The overlay only shows subtitles while the translation is running.'}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,0,0,s'}"
                                                   Text="{t:T 'Streaming with a capture card? In OBS add a Browser source with this address (width 1920, height 1080). The Turkish subtitles appear over the game on your screen and on the stream.'}" />
                                        <c:CopyField x:Name="ObsAddress" />
                                    </StackPanel>
                                </c:Unit>
                                <StackPanel x:Name="NetworkObsPanel">
                                    <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,0,0,s'}"
                                               Text="{t:T 'Your streaming app does not accept localhost (TikTok LIVE Studio, for example)? Use this address with the computer\'s network address:'}" />
                                    <c:CopyField x:Name="NetworkObsAddress" />
                                </StackPanel>
                            </c:SpacedStack>
                        </c:Card>
                    </c:SpacedStack>
                </Grid>
            </TabItem>

            <!-- ───── Klavye Kısayolları ───── -->
            <TabItem x:Name="ShortcutsTab">
                <StackPanel Margin="{t:Sp '0,0,0,l'}">
                    <c:Card Title="{t:T 'Keyboard shortcuts'}">
                        <c:SpacedStack>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{t:T 'Each action has two shortcuts, so it also works on keyboards without a numeric keypad. Click a shortcut and press the new keys. Backspace removes it, Esc cancels.'}" />
                            <Grid x:Name="ShortcutGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock x:Name="ShortcutMessage" Style="{StaticResource HintText}" Visibility="Collapsed" />
                            <TextBlock x:Name="ShortcutError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                            <c:Unit Hint="{t:T 'The shortcuts work only while translating, even when CouchSubs is in the background.'}">
                                <Button Content="{t:T 'Restore defaults'}" Style="{StaticResource CompactButton}" Click="OnShortcutDefaults" HorizontalAlignment="Left" />
                            </c:Unit>
                        </c:SpacedStack>
                    </c:Card>
                </StackPanel>
            </TabItem>

            <!-- ───── Konsol ve Kaynak ───── -->
            <TabItem x:Name="PictureSourceSection">
                <Grid Margin="{t:Sp '0,0,0,l'}" c:Responsive.StackBelow="{x:Static c:Responsive.TwoColumnMin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{t:Sp l}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:SpacedStack Gap="l">
                        <!-- Konsol (Mac ConsoleSettingsCard): PS5 ↔ Xbox seçici; Xbox'ta Microsoft hesap kartı (Mac DSAccountCard). -->
                        <c:Card x:Name="ConsoleCard" Title="{t:T 'Console'}">
                            <c:SpacedStack>
                                <Border x:Name="ConsoleTabs" Style="{StaticResource SegmentGroup}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="ConsolePlayStation" Content="PlayStation 5" GroupName="console" Style="{StaticResource SegmentButton}" Checked="OnConsoleKind" Tag="PlayStation" />
                                        <RadioButton x:Name="ConsoleXbox" Content="Xbox" GroupName="console" Style="{StaticResource SegmentButton}" Checked="OnConsoleKind" Tag="Xbox" />
                                    </UniformGrid>
                                </Border>
                                <!-- PS5 bilgi satırı (Mac DSRow): ad, altında IP (yoksa kısa açıklama), sağda Bağlı / Kurulmadı rozeti. -->
                                <DockPanel x:Name="ConsolePlayStationHint" LastChildFill="True">
                                    <c:Chip x:Name="ConsolePs5Badge" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="{t:Sp 's,0,0,0'}" />
                                    <c:SectionTitle x:Name="ConsolePs5Row" Title="PS5" Text="{t:T 'With Remote Play and a second PSN account.'}" />
                                </DockPanel>
                                <!-- PS5 adresi elle (Mac/iPhone/Android konsol kartıyla aynı): adres değişip ağda bulunamazsa yeni adres yazılır. -->
                                <c:SpacedStack x:Name="Ps5AddressActions" Gap="xs" Visibility="Collapsed">
                                    <WrapPanel>
                                        <Button Content="{t:T 'Enter IP Address'}" Margin="{t:Sp '0,0,0,xs'}" Click="OnEnterPs5Address" />
                                    </WrapPanel>
                                    <Grid x:Name="Ps5AddressPanel" Visibility="Collapsed">
                                        <TextBox x:Name="Ps5Address" FontFamily="{StaticResource MonoFont}" Padding="{t:Sp 'm,0,xxl,0'}" KeyDown="OnPs5AddressKey"
                                                 ToolTip="{t:T 'IP address, e.g. 192.168.1.20'}" />
                                        <Button Content="{t:T 'Save'}" Style="{StaticResource CompactButton}" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="{t:Sp '0,0,xs,0'}" Click="OnUsePs5Address" />
                                    </Grid>
                                    <TextBlock x:Name="Ps5AddressError" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Visibility="Collapsed" />
                                </c:SpacedStack>
                                <!-- PSN'den çıkış (iPhone/Android Profil ile aynı ad ve onay): ikinci hesap ve PS5 eşleşmesi silinir, başka hesapla girilir. -->
                                <WrapPanel x:Name="PsnSignOutRow" Visibility="Collapsed">
                                    <Button Content="{t:T 'Sign out of PSN and reset the account'}" Style="{StaticResource CompactButton}" Click="OnSignOutPsn" />
                                </WrapPanel>
                                <c:SpacedStack x:Name="ConsoleXboxPanel">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource UnitTitleText}"><Run Text="{t:T 'Xbox and connection'}" /><Run x:Name="ConsoleXboxName" /></TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,titleBody,0,0'}"
                                                   Text="{t:T 'Xbox support is in Beta. If something goes wrong, tell us and we\'ll fix it as soon as we can.'}" />
                                    </StackPanel>
                                    <c:AccountCard x:Name="MicrosoftAccount" Badge="MS" Title="{t:T 'Microsoft Account'}" SignIn="OnLinkXbox">
                                        <c:SpacedStack x:Name="ConsoleXboxSignedIn" Orientation="Horizontal" Gap="xs">
                                            <Button x:Name="ConsoleXboxLink" Style="{StaticResource CompactButton}" Click="OnLinkXbox" />
                                            <Button Content="{t:T 'Sign out of Microsoft'}" Style="{StaticResource CompactButton}" Click="OnSignOutXbox" />
                                        </c:SpacedStack>
                                    </c:AccountCard>
                                </c:SpacedStack>
                            </c:SpacedStack>
                        </c:Card>
                        <c:Card x:Name="PasscodeTab" Title="{t:T 'PS5 login passcode'}">
                            <c:SpacedStack>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{t:T 'Only needed if the second account has a login passcode on the PS5. CouchSubs enters it when the PS5 asks. It is stored encrypted on this PC.'}" />
                                <StackPanel>
                                    <Grid x:Name="NewPasscode">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PasscodeBox" MaxLength="4" />
                                        <Button Grid.Column="1" Content="{t:T 'Save'}" Margin="{t:Sp 's,0,0,0'}" Click="OnPasscodeSave" />
                                    </Grid>
                                    <DockPanel x:Name="SavedPasscode" LastChildFill="False">
                                        <TextBlock Text="{t:T 'Passcode saved.'}" Style="{StaticResource DoneText}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="{t:T 'Remove passcode'}" Style="{StaticResource CompactButton}" Click="OnPasscodeRemove" />
                                    </DockPanel>
                                    <TextBlock x:Name="PasscodeError" Style="{StaticResource ErrorText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'Enter the 4-digit passcode.'}" Visibility="Collapsed" />
                                </StackPanel>
                            </c:SpacedStack>
                        </c:Card>
                        <!-- Hakkında ve yeniden kurulum (Mac AboutCard). -->
                        <c:Card>
                            <c:SpacedStack>
                                <TextBlock x:Name="InstalledVersion" Style="{StaticResource HintText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{t:T 'About CouchSubs'}" Click="OnAbout" />
                                    <Button Grid.Column="2" Content="{t:T 'Set Up Again…'}" Style="{StaticResource DangerButton}" Click="OnReset" />
                                </Grid>
                            </c:SpacedStack>
                        </c:Card>
                    </c:SpacedStack>
                    <c:SpacedStack Grid.Column="2" Gap="l">
                        <!-- "Görüntüyü al": PS5'te PS5 / Remote Play penceresi / OBS veya oyun penceresi; Xbox'ta Xbox (bu uygulama
                             bağlanır) / OBS veya oyun penceresi (#853: Xbox uygulaması, play.xbox.com, capture card; Xbox'a bağlanılmaz). -->
                        <c:Card x:Name="PictureSourceCard" Title="{t:T 'Read the picture from'}">
                            <c:SpacedStack>
                                <ComboBox x:Name="FrameSourceChoice" SelectionChanged="OnFrameSource">
                                    <ComboBoxItem x:Name="XboxSourceItem" Content="{t:T 'Xbox (this app connects)'}" Tag="Xbox" />
                                    <ComboBoxItem x:Name="Ps5SourceItem" Content="{t:T 'The PS5 (second account)'}" Tag="Ps5" />
                                    <ComboBoxItem x:Name="RemotePlaySourceItem" Content="{t:T 'Remote Play window on this PC'}" Tag="RemotePlayWindow" />
                                    <ComboBoxItem Content="{t:T 'OBS projector or game window'}" Tag="CaptureWindow" />
                                </ComboBox>
                                <TextBlock x:Name="XboxWindowHint" Style="{StaticResource HintText}"
                                           Text="{t:T 'If you play in the Xbox app, on play.xbox.com or with a capture card in OBS, choose this window; CouchSubs doesn\'t connect to the Xbox separately (the Xbox allows only one connection at a time).'}" />
                                <c:Unit x:Name="RemotePlayAppPanel" Title="{t:T 'Remote Play app'}">
                                    <ComboBox x:Name="RemotePlayAppChoice" SelectionChanged="OnRemotePlayApp">
                                        <ComboBoxItem Content="{t:T 'Whichever is open'}" Tag="Automatic" />
                                        <ComboBoxItem Content="{t:T 'PS Remote Play (Sony)'}" Tag="Sony" />
                                        <ComboBoxItem Content="{t:T 'chiaki-ng'}" Tag="Chiaki" />
                                    </ComboBox>
                                </c:Unit>
                                <TextBlock x:Name="WindowSourceHint" Style="{StaticResource HintText}"
                                           Text="{t:T 'Play in PS Remote Play or chiaki-ng on this PC; CouchSubs reads only that window, so no second account is needed. Show the subtitles on the computer screen.'}" />
                                <StackPanel x:Name="CaptureWindowPanel" Visibility="Collapsed">
                                    <TextBlock Text="{t:T 'Open an OBS projector or game window, then select it below. Only that window is read: CouchSubs never switches to the whole desktop when it closes.'}"
                                               Style="{StaticResource HintText}" Margin="{t:Sp '0,0,0,s'}" />
                                    <!-- Tuval 14: başlık satırında sağda "Pencereleri Yenile"; pencereler seçenek kartı (ad ve uygulama). -->
                                    <DockPanel Margin="{t:Sp '0,0,0,s'}">
                                        <Button Content="{t:T 'Refresh Windows'}" DockPanel.Dock="Right" Style="{StaticResource CompactButton}" VerticalAlignment="Center"
                                                Click="OnRefreshCaptureWindows" />
                                        <TextBlock Text="{t:T 'OBS projector or game window'}" Style="{StaticResource UnitTitleText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel x:Name="CaptureWindowCards" />
                                    <ComboBox x:Name="CaptureWindowChoice" Visibility="Collapsed" SelectionChanged="OnCaptureWindowChanged" />
                                    <TextBlock x:Name="CaptureWindowEmpty" Style="{StaticResource HintText}" Margin="{t:Sp '0,unitHint,0,0'}"
                                               Text="{t:T 'No suitable windows found. Open OBS or the game first, then refresh.'}" />
                                    <!-- OBS'in Program/Önizleme projektörü CouchSubs'ın OBS katmanını da içerir (OwnSubtitles). -->
                                    <c:Callout x:Name="SourceProjectorHint" Margin="{t:Sp '0,s,0,0'}" Visibility="Collapsed"
                                               Text="{t:T 'If you use the CouchSubs OBS overlay, select the Source Projector of your capture card source as the video source: in OBS, right-click the source › Open Source Projector › New window. The Program and Preview projectors also contain CouchSubs\' own subtitles.'}" />
                                </StackPanel>
                                <!-- Kurulu olanlar "Kurulu", olmayanlar resmi indirme sayfasına giden düğmeyle (ikisi de denenebilir). -->
                                <Grid x:Name="SonyInstallRow">
                                    <TextBlock Text="{t:T 'PS Remote Play (Sony)'}" Style="{StaticResource UnitTitleText}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SonyInstalledText" Style="{StaticResource HintText}" Text="{t:T 'Installed'}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button x:Name="SonyDownloadButton" Content="{t:T 'Download PS Remote Play'}" Style="{StaticResource CompactButton}" HorizontalAlignment="Right" Click="OnDownloadSony" />
                                </Grid>
                                <Grid x:Name="ChiakiInstallRow">
                                    <TextBlock Text="{t:T 'chiaki-ng'}" Style="{StaticResource UnitTitleText}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChiakiInstalledText" Style="{StaticResource HintText}" Text="{t:T 'Installed'}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button x:Name="ChiakiDownloadButton" Content="{t:T 'Download chiaki-ng'}" Style="{StaticResource CompactButton}" HorizontalAlignment="Right" Click="OnDownloadChiaki" />
                                </Grid>
                                <TextBlock x:Name="Ps5SourceHint" Style="{StaticResource HintText}"
                                           Text="{t:T 'CouchSubs connects to the PS5 with the second account. Sony\'s PS Remote Play can\'t be used at the same time.'}" />
                                <!-- PS5 seçili ama ikinci hesap ya da PS5 eşleşmesi yok: sihirbazı ikinci hesap adımından açar. -->
                                <c:Callout x:Name="Ps5LinkPanel" Text="{t:T 'The PS5 is not linked yet. Sign in with the second account and pair the PS5.'}">
                                    <Button Content="{t:T 'Link account'}" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Margin="{t:Sp '0,s,0,0'}" Click="OnLinkPs5" />
                                </c:Callout>
                            </c:SpacedStack>
                        </c:Card>
                        <c:Card x:Name="XboxPictureSourceCard" Title="Xbox" Visibility="Collapsed">
                            <c:SpacedStack>
                                <c:SwitchRow x:Name="XboxAudioOnComputer" Content="{t:T 'Play Xbox sound on this computer'}"
                                             Description="{t:T 'While Xbox Remote Play is running, the Xbox mutes the TV and sends game sound only to this computer (an Xbox limitation). If you turn this off, the game has no sound. To hear it from the TV or speakers, set the sound output of this computer to them.'}"
                                             Checked="OnXboxAudioOnComputer" Unchecked="OnXboxAudioOnComputer" />
                                <c:SwitchRow x:Name="XboxLegacyFrameRate" Content="{t:T 'Restore the old Xbox frame rate'}"
                                             Description="{t:T 'On: read an Xbox frame every 200 ms to use less CPU. Off (default): every 66 ms for faster subtitles.'}"
                                             Checked="OnXboxLegacyFrameRate" Unchecked="OnXboxLegacyFrameRate" />
                            </c:SpacedStack>
                        </c:Card>
                        <!-- TV girişi (Mac ConsoleSettings): kurulumda seçilen HDMI; değişince TV uygulaması o girişi açar (style.hdmiInput). -->
                        <c:Card x:Name="HdmiCard" Title="{t:T 'TV input (HDMI)'}" Visibility="Collapsed">
                            <Border Style="{StaticResource SegmentGroup}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="Hdmi1" Content="HDMI 1" Tag="1" GroupName="hdmi" Style="{StaticResource SegmentButton}" Checked="OnHdmiInput" />
                                    <RadioButton x:Name="Hdmi2" Content="HDMI 2" Tag="2" GroupName="hdmi" Style="{StaticResource SegmentButton}" Checked="OnHdmiInput" />
                                    <RadioButton x:Name="Hdmi3" Content="HDMI 3" Tag="3" GroupName="hdmi" Style="{StaticResource SegmentButton}" Checked="OnHdmiInput" />
                                    <RadioButton x:Name="Hdmi4" Content="HDMI 4" Tag="4" GroupName="hdmi" Style="{StaticResource SegmentButton}" Checked="OnHdmiInput" />
                                </UniformGrid>
                            </Border>
                        </c:Card>
                        <c:Card x:Name="LanguageCard" Title="{t:T 'Language'}">
                            <c:Unit Title="{t:T 'Game language'}">
                                <ComboBox x:Name="GameLanguage" SelectionChanged="OnLanguage" />
                            </c:Unit>
                        </c:Card>
                        <!-- Deneme modu: konsol olmadan örnek görüntülerle çeviri (Mac'teki DemoModeCard). -->
                        <local:DemoModeCard />
                    </c:SpacedStack>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<!-- Geçmiş: bu ve önceki oturumlarda çevrilen satırlar, en yenisi üstte; satır satır ya da hepsi kopyalanır. -->
<Window x:Class="CouchSubs.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        Title="{t:T 'History'}" Width="640" Height="640" MinWidth="480" MinHeight="400" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource windowBackgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}">
    <Grid Margin="{DynamicResource pad.screen}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{t:T 'History'}" Style="{StaticResource DisplayText}" />
            <TextBlock x:Name="KeptHint" Style="{StaticResource HintText}" Margin="0,4,0,0" />
        </StackPanel>

        <c:Card Grid.Row="1">
            <Grid>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Top"
                           Text="{t:T 'No subtitles yet. Lines translated in this and earlier sessions appear here.'}" />
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="Lines" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Satır: saat ve kaynak, Türkçe, İngilizce; sağda "Kopyala". Satırlar ince çizgiyle ayrılır. -->
                                <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{t:T 'Copy'}" VerticalAlignment="Top" Margin="12,0,0,0" Padding="12,0"
                                                Click="OnCopy" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CaptionText}" Typography.NumeralAlignment="Tabular">
                                                <Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Origin, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Translation}" Style="{StaticResource HeadlineText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </c:Card>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="CopyAll" Content="{t:T 'Copy all'}" Click="OnCopyAll" Margin="0,0,8,0" />
            <Button x:Name="ClearAll" Content="{t:T 'Clear'}" Click="OnClear" />
            <Button DockPanel.Dock="Right" Content="{t:T 'Close'}" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="OnClose" />
        </DockPanel>
    </Grid>
</Window>

<!-- Ana ekran: solda başlat/durdur ve durum karoları, sağda paket karosu ve canlı altyazı. -->
<UserControl x:Class="CouchSubs.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views">
    <DockPanel Margin="{DynamicResource pad.screen}">
        <!-- Başlık: logo, ad, ayarlar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Grid Width="36" Height="36">
                    <Image Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Koyu temada logonun kenarı zeminden ayrılsın. -->
                    <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="8.1" />
                </Grid>
                <TextBlock Text="CouchSubs" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="16,0" Margin="0,0,8,0" ToolTip="{t:T 'History'}" Click="OnHistory">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Glyphs.History}" Style="{StaticResource GlyphText}" FontSize="20" Margin="0,0,8,0" />
                        <TextBlock Text="{t:T 'History'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Padding="16,0" ToolTip="{t:T 'Settings'}" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="20" Margin="0,0,8,0" />
                        <TextBlock Text="{t:T 'Settings'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: denetimler ve durum -->
            <ScrollViewer Width="{DynamicResource size.mainColumn}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,16,0">
                <StackPanel Margin="0,0,0,8">
                    <!-- Yeni sürüm -->
                    <c:Card x:Name="UpdateCard" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateBar" Minimum="0" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateErrorText" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                            <Button x:Name="UpdateButton" Content="{t:T 'Update now'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="OnUpdate" />
                        </StackPanel>
                    </c:Card>

                    <!-- Başlat / Durdur -->
                    <Button x:Name="Toggle" HorizontalAlignment="Stretch" MinHeight="{DynamicResource size.primaryActionHeight}" Click="OnToggle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToggleGlyph" Style="{StaticResource GlyphText}" FontSize="20" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="ToggleText" FontSize="{DynamicResource headlineFontSize}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Deneme altyazısı: altyazı TV'ye gidiyorsa "TV'de dene", yalnız bilgisayardaysa "Ekranda dene" -->
                    <Button HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnTest">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="{t:T 'Test on screen'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsOnTv}" Value="True">
                                        <Setter Property="Content" Value="{t:T 'Test on TV'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Durum karoları -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <c:Card>
                            <c:Card.Style>
                                <!-- Altyazı yalnız bilgisayar ekranındaysa TV karosu yoktur; PS5 karosu iki sütunu kaplar. -->
                                <Style TargetType="c:Card" BasedOn="{StaticResource {x:Type c:Card}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsOnTv}" Value="False">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Card.Style>
                            <c:StatusRow Title="PS5" Glyph="{x:Static c:Glyphs.Controller}" Value="{Binding Ps5StatusText}" Tone="{Binding Ps5Tone}" />
                        </c:Card>

                        <!-- Altyazı yalnız bilgisayar ekranındaysa TV durumu gösterilmez. -->
                        <c:Card Grid.Column="2" Visibility="{Binding ShowsOnTv, Converter={StaticResource VisibleIf}}">
                            <c:Card.Style>
                                <Style TargetType="c:Card" BasedOn="{StaticResource {x:Type c:Card}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TvTone}" Value="Good">
                                            <Setter Property="Kind" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Card.Style>
                            <StackPanel>
                                <c:StatusRow Title="TV" Glyph="{x:Static c:Glyphs.Tv}" Value="{Binding TvStatusText}" Tone="{Binding TvTone}" />
                                <Button Content="{t:T 'Connect a TV'}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,0" Click="OnConnectTv"
                                        Visibility="{Binding NeedsTv, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </c:Card>

                        <!-- Altyazının yeri: TV, bilgisayar ekranı ya da ikisi -->
                        <local:SubtitleOutputCard x:Name="OutputCard" Grid.Row="2" Grid.ColumnSpan="3" />

                        <c:Card Grid.Row="4">
                            <StackPanel>
                                <Border Style="{StaticResource TileIcon}" Margin="0,0,0,8">
                                    <TextBlock Text="{x:Static c:Glyphs.Globe}" Style="{StaticResource GlyphText}" FontSize="18" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{t:T 'Translation'}" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="EngineText" Style="{StaticResource HeadlineText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Grid.Row="4" Grid.Column="2">
                            <StackPanel>
                                <Border Style="{StaticResource TileIcon}" Margin="0,0,0,8">
                                    <TextBlock Text="{x:Static c:Glyphs.Keyboard}" Style="{StaticResource GlyphText}" FontSize="18" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{t:T 'Shortcut'}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{t:T 'Translate the screen (Num 9 or Ctrl+Shift+9)'}" Style="{StaticResource HeadlineText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </c:Card>
                    </Grid>

                    <!-- PS5 ya da TV uzun süredir bağlanamıyor ve güvenlik duvarında izin yok -->
                    <local:FirewallCard Margin="0,16,0,0" />

                    <!-- Çeviri modeli eksik -->
                    <c:Card x:Name="ModelCard" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The translation model is not downloaded yet.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                            <StackPanel Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
                                <TextBlock Text="{t:T 'Downloading…'}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelProgress, Mode=OneWay}" />
                            </StackPanel>
                            <Button Content="{t:T 'Download the model'}" Margin="0,12,0,0" Click="OnDownload"
                                    Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        </StackPanel>
                    </c:Card>

                    <!-- Ücretsiz çeviri motoru (ONNX Runtime) bu bilgisayarda açılamadı: çevrimiçi motor önerilir -->
                    <c:Card x:Name="EngineCard" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The free translation engine could not start on this computer.'}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{t:T 'Choose Gemini (free) or DeepL in Settings › Translation.'}" Style="{StaticResource HintText}"
                                       Margin="0,8,0,12" TextWrapping="Wrap" />
                            <Button Content="{t:T 'Settings'}" HorizontalAlignment="Left" Click="OnSettings" />
                        </StackPanel>
                    </c:Card>

                    <!-- Çevrimiçi motor çeviremiyor: satırlar bu arada ücretsiz çeviriyle geliyor -->
                    <c:Card x:Name="OnlineCard" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="OnlineTitle" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnlineReason" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </c:Card>

                    <!-- Yazı tanıma dili eksik -->
                    <c:Card Margin="0,16,0,0" Visibility="{Binding OcrMissing, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="{t:T 'Text recognition for the game language is not installed on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,12" TextWrapping="Wrap"
                                       Text="{t:T 'Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission.'}" />
                            <WrapPanel>
                                <Button x:Name="InstallOcr" Content="{t:T 'Install text recognition'}" Click="OnInstallOcr" Margin="0,0,8,8" />
                                <Button Content="{t:T 'Open language settings'}" Click="OnLanguageSettings" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ: oyun paketi ve canlı altyazı -->
            <DockPanel Grid.Column="1">
                <c:Card x:Name="PackTile" DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="Collapsed">
                    <DockPanel>
                        <Border Style="{StaticResource ProIcon}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Package}" Style="{StaticResource GlyphText}" FontSize="18" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PackText" VerticalAlignment="Center" />
                    </DockPanel>
                </c:Card>

                <!-- Canlı altyazı: son satır büyük ve altyazı sarısında (karo parlamaz) -->
                <c:Card Title="{t:T 'Live subtitles'}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="{t:T 'Subtitles will appear here while you play.'}" Style="{StaticResource HintText}"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding LastTranslation}" Style="{StaticResource LiveText}" Foreground="{DynamicResource accentTextBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding LastSource}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                        <!-- Son satırın ölçümleri: yazı tanıma, çeviri, gecikme (sessiz, 13 pt, sabit genişlikli rakamlar) -->
                        <TextBlock Text="{Binding MetricsText}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding MetricsText, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                </c:Card>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

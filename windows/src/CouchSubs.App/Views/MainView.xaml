<!-- Ana ekran: solda başlat/durdur ve durum karoları, sağda paket karosu ve canlı altyazı. -->
<UserControl x:Class="CouchSubs.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views">
    <DockPanel Margin="{DynamicResource pad.screen}">
        <!-- Başlık: logo, ad, ayarlar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="36" Height="36">
                    <Image Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Koyu temada logonun kenarı zeminden ayrılsın. -->
                    <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="8.1" />
                </Grid>
                <TextBlock Text="CouchSubs" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="14,0" Margin="0,0,8,0" ToolTip="{t:T 'History'}" Click="OnHistory">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Glyphs.History}" Style="{StaticResource GlyphText}" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="{t:T 'History'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Padding="14,0" ToolTip="{t:T 'Settings'}" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="{t:T 'Settings'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: denetimler ve durum -->
            <ScrollViewer Width="{DynamicResource size.mainColumn}" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,12,0">
                <StackPanel Margin="0,0,0,8">
                    <!-- Yeni sürüm -->
                    <c:Card x:Name="UpdateCard" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateBar" Minimum="0" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateErrorText" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                            <Button x:Name="UpdateButton" Content="{t:T 'Update now'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="OnUpdate" />
                            <Expander x:Name="UpdateNotes" Margin="0,8,0,0" Header="{t:T 'Release notes'}"
                                      Foreground="{DynamicResource textPrimaryBrush}" Expanded="OnUpdateNotesExpanded">
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <TextBlock x:Name="UpdateNotesText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </c:Card>

                    <!-- Başlat / Durdur -->
                    <Button x:Name="Toggle" HorizontalAlignment="Stretch" MinHeight="{DynamicResource size.primaryActionHeight}" Click="OnToggle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToggleGlyph" Style="{StaticResource GlyphText}" FontSize="18" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="ToggleText" FontSize="{DynamicResource headlineFontSize}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Deneme altyazısı: altyazı TV'ye gidiyorsa "TV'de dene", yalnız bilgisayardaysa "Ekranda dene" -->
                    <Button HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnTest">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="{t:T 'Test on screen'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsOnTv}" Value="True">
                                        <Setter Property="Content" Value="{t:T 'Test on TV'}" />
                                    </DataTrigger>
                                    <!-- TV uygulaması bağlı değilse önce TV'de açılır, bağlanınca deneme altyazısı gider. -->
                                    <DataTrigger Binding="{Binding OpeningTvAppForTest}" Value="True">
                                        <Setter Property="Content" Value="{t:T 'Opening the app on the TV…'}" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Durum karoları -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <c:Card>
                            <c:Card.Style>
                                <!-- Altyazı yalnız bilgisayar ekranındaysa TV karosu yoktur; PS5 karosu iki sütunu kaplar. -->
                                <Style TargetType="c:Card" BasedOn="{StaticResource {x:Type c:Card}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsOnTv}" Value="False">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Card.Style>
                            <c:StatusRow Title="{Binding ConsoleTitle}" Glyph="{x:Static c:Glyphs.Controller}" Value="{Binding Ps5StatusText}" Tone="{Binding Ps5Tone}" />
                        </c:Card>

                        <!-- Altyazı yalnız bilgisayar ekranındaysa TV durumu gösterilmez. -->
                        <c:Card Grid.Column="2" Visibility="{Binding ShowsOnTv, Converter={StaticResource VisibleIf}}">
                            <c:Card.Style>
                                <Style TargetType="c:Card" BasedOn="{StaticResource {x:Type c:Card}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TvTone}" Value="Good">
                                            <Setter Property="Kind" Value="Active" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Card.Style>
                            <StackPanel>
                                <c:StatusRow Title="TV" Glyph="{x:Static c:Glyphs.Tv}" Value="{Binding TvStatusText}" Tone="{Binding TvTone}" />
                                <Button Content="{t:T 'Connect a TV'}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,0" Click="OnConnectTv"
                                        Visibility="{Binding NeedsTv, Converter={StaticResource VisibleIf}}" />
                                <!-- TV uygulaması bağlanmıyor (ör. TV'den kaldırıldı): TV adımı açılır, uygulama yeniden kurulur ya da açılır. -->
                                <Button Content="{t:T 'Reinstall the TV app'}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,0" Click="OnReinstallTvApp"
                                        Visibility="{Binding CanReinstallTvApp, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </c:Card>

                        <!-- Altyazının yeri: TV, bilgisayar ekranı ya da ikisi -->
                        <local:SubtitleOutputCard x:Name="OutputCard" Grid.Row="2" Grid.ColumnSpan="3" />

                        <!-- Bilgi karosu: çeviri motoru (Ayarlar › Çeviri'yi açar) ve ekranı çevirme kısayolu. Canlı durum değil, ayar
                             bilgisi olduğu için durum karoları gibi simgeli ve büyük değil (docs/TASARIM.md › InfoCard). -->
                        <c:Card Grid.Row="4" Grid.ColumnSpan="3" Padding="16,4">
                            <StackPanel>
                                <!-- Görüntünün nereden okunduğu; dokununca Ayarlar › Görüntü kaynağı (Xbox'ta gizli). -->
                                <StackPanel x:Name="PictureSourceRow">
                                    <Button Style="{StaticResource InfoRowButton}" Click="OnPictureSourceSettings"
                                            AutomationProperties.Name="{t:T 'Picture source'}">
                                        <DockPanel>
                                            <TextBlock Text="{t:T 'Picture source'}" Style="{StaticResource InfoRowLabel}" />
                                            <TextBlock x:Name="PictureSourceText" Style="{StaticResource InfoRowValue}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                                        </DockPanel>
                                    </Button>
                                    <Border Style="{StaticResource InfoDivider}" />
                                </StackPanel>
                                <Button Style="{StaticResource InfoRowButton}" Click="OnTranslationSettings"
                                        AutomationProperties.Name="{t:T 'Translation'}">
                                    <DockPanel>
                                        <TextBlock Text="{t:T 'Translation'}" Style="{StaticResource InfoRowLabel}" />
                                        <TextBlock x:Name="EngineText" Style="{StaticResource InfoRowValue}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                                    </DockPanel>
                                </Button>
                                <Border Style="{StaticResource InfoDivider}" />
                                <DockPanel Style="{StaticResource InfoRow}">
                                    <TextBlock Text="{t:T 'Translate screen'}" Style="{StaticResource InfoRowLabel}" />
                                    <!-- Ayarlar › Kısayollar'da seçili tuşlar, her biri bir tuş; kısayol yoksa "kısayol yok" (ShowScreenKeys). -->
                                    <StackPanel x:Name="ScreenKeys" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </c:Card>
                    </Grid>

                    <!-- Oynanan oyun ("Oynanan oyun: X · Değiştir") ve iki dakika sonra çıkan "Hangi oyunu oynuyorsunuz?" kartı -->
                    <c:Card x:Name="GameCard" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel x:Name="GameRow">
                                <Button x:Name="GameChangeButton" DockPanel.Dock="Right" Padding="16,0" VerticalAlignment="Center" Click="OnChangeGame" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{t:T 'Played game'}" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="PlayedGameText" Style="{StaticResource HeadlineText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Oyunun kayıtlı alanları: uygulandı ("Geri al") ya da paketten tanınan oyunda soru ("Kullan" / "Hayır") -->
                            <DockPanel x:Name="AreaProfileRow" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="AreaProfileUse" Content="{t:T 'Use'}" Padding="16,0" Click="OnUseAreaProfile" />
                                    <Button x:Name="AreaProfileNo" Content="{t:T 'No'}" Padding="16,0" Margin="8,0,0,0" Click="OnDeclineAreaProfile" />
                                    <Button x:Name="AreaProfileUndo" Content="{t:T 'Undo'}" Padding="16,0" Click="OnUndoAreaProfile" />
                                </StackPanel>
                                <TextBlock x:Name="AreaProfileText" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel x:Name="GameAsk" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{t:T 'Don\'t ask'}" Padding="12,0" Click="OnDontAskGame" />
                                    <TextBlock Text="{t:T 'Which game are you playing?'}" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,12"
                                           Text="{t:T 'Lines that are not in a pack go to the shared pool with the game\'s name, so its ready translation comes sooner.'}" />
                                <TextBlock Text="{t:T 'Search games'}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <TextBox x:Name="GameSearch" TextChanged="OnGameSearch" KeyDown="OnGameSearchKey"
                                         AutomationProperties.Name="{t:T 'Search games'}" />
                                <StackPanel x:Name="GameList" Margin="0,8,0,0" />
                                <Button x:Name="GameCustom" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="16,0" Visibility="Collapsed" Click="OnCustomGame" />
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- PS5 ya da TV uzun süredir bağlanamıyor ve güvenlik duvarında izin yok -->
                    <local:FirewallCard Margin="0,12,0,0" />

                    <!-- Çeviri modeli eksik -->
                    <c:Card x:Name="ModelCard" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The translation model is not downloaded yet.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                            <StackPanel Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
                                <TextBlock Text="{t:T 'Downloading…'}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelProgress, Mode=OneWay}" />
                            </StackPanel>
                            <Button Content="{t:T 'Download the model'}" Margin="0,12,0,0" Click="OnDownload"
                                    Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        </StackPanel>
                    </c:Card>

                    <c:Card Margin="0,12,0,0" Visibility="{Binding GpuFallbackWarning, Converter={StaticResource VisibleIf}}">
                        <TextBlock Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap"
                                   Text="{t:T 'GPU could not be used; free translation is running on CPU.'}" />
                    </c:Card>
                    <!-- Ücretsiz çeviri motoru bu bilgisayarda açılamadı: çevrimiçi motor önerilir -->
                    <c:Card x:Name="EngineCard" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The free translation engine could not start on this computer.'}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{t:T 'Choose Gemini (free) or DeepL in Settings › Translation.'}" Style="{StaticResource HintText}"
                                       Margin="0,8,0,12" TextWrapping="Wrap" />
                            <Button Content="{t:T 'Settings'}" HorizontalAlignment="Left" Click="OnSettings" />
                        </StackPanel>
                    </c:Card>

                    <!-- Çevrimiçi motor çeviremiyor: satırlar bu arada ücretsiz çeviriyle geliyor -->
                    <c:Card x:Name="OnlineCard" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="OnlineTitle" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnlineReason" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </c:Card>

                    <!-- Yazı tanıma dili eksik -->
                    <c:Card Margin="0,12,0,0" Visibility="{Binding OcrMissing, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="{t:T 'Text recognition for the game language is not installed on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,12" TextWrapping="Wrap"
                                       Text="{t:T 'Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission.'}" />
                            <WrapPanel>
                                <Button x:Name="InstallOcr" Content="{t:T 'Install text recognition'}" Click="OnInstallOcr" Margin="0,0,8,8" />
                                <Button Content="{t:T 'Open language settings'}" Click="OnLanguageSettings" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ: oyun paketi ve canlı altyazı -->
            <DockPanel Grid.Column="1">
                <c:Card x:Name="PackTile" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
                    <DockPanel>
                        <Border Style="{StaticResource ProIcon}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Package}" Style="{StaticResource GlyphText}" FontSize="18" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PackText" VerticalAlignment="Center" />
                    </DockPanel>
                </c:Card>

                <!-- Canlı altyazı: son satır büyük ve altyazı sarısında (karo parlamaz) -->
                <c:Card Title="{t:T 'Live subtitles'}" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{t:T 'Subtitles will appear here while you play.'}" Style="{StaticResource HintText}"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        <!-- Çeviri PS5'ten (ikinci hesap) okunurken: kolu açınca ana hesap seçilmeli (GitHub #231). -->
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{t:T 'When you turn on the controller to play, choose your MAIN account on the PS5. Don\'t play with the second account CouchSubs signs in with, or the controller will turn off by itself or won\'t work in the game.'}"
                                   Visibility="{Binding ShowsMainAccountTip, Converter={StaticResource VisibleIf}}" />
                        <!-- Görüntü bir dakikadır geliyor ama hiç altyazı satırı okunmadı (GitHub #503, #566, #572). -->
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{t:T 'Turn on the game\'s own subtitles: CouchSubs reads the English subtitles on screen, not the audio.'}"
                                   Visibility="{Binding ShowsSubtitleOffTip, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{t:T '“Watch subtitle background” is on: only text on GTA 6’s dark subtitle panel is read. Set the game’s subtitle background to Solid or turn this setting off.'}"
                                   Visibility="{Binding ShowsSubtitleBackgroundTip, Converter={StaticResource VisibleIf}}" />
                        <TextBlock x:Name="LiveLine" Text="{Binding LastTranslation}" Style="{StaticResource LiveText}" Foreground="{DynamicResource accentTextBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding LastSource}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                        <!-- Son satırın ölçümleri: yazı tanıma, çeviri, gecikme (sessiz, 13 pt, sabit genişlikli rakamlar) -->
                        <TextBlock Text="{Binding MetricsText}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding MetricsText, Converter={StaticResource VisibleIf}}" />
                        <!-- Bu oturumun önceki satırları: ayraçlarla, karo başlığı boyunda normal ve ikincil renkte; en yenisi üstte
                             (Mac'teki canlı altyazı karosu ve docs/TASARIM.md › Ana ekran). -->
                        <ItemsControl x:Name="PreviousLines" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation}" Style="{StaticResource HeadlineText}" FontWeight="Normal"
                                                       Foreground="{DynamicResource textSecondaryBrush}" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </c:Card>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

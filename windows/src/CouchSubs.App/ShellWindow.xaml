<!-- Uygulamanın tek penceresi (yeni arayüz): üstte 72 yükseklikte çubuk (solda logo ve ad, ortada Ana Ekran / Geçmiş / Ayarlar
     sekmeleri, sağda durum hapı), altında seçili sayfa, en altta reklam bandı. Kurulumda çubuk ve reklam yok.
     En küçük boy 1200 × 760; büyüyünce sütunlar oransal genişler, içerik en fazla 1680 genişlikte ortalanır. -->
<Window x:Class="CouchSubs.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        Title="CouchSubs" Icon="Assets/CouchSubs.ico"
        Width="{DynamicResource size.windowWidth}" Height="{DynamicResource size.windowHeight}"
        Background="{DynamicResource windowBackgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}"
        TextElement.Foreground="{DynamicResource textPrimaryBrush}" WindowStartupLocation="CenterScreen">
    <Grid x:Name="Frame" MaxWidth="{DynamicResource size.contentMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk: üç sütun (1fr auto 1fr), yanlarda 24. -->
        <Grid x:Name="TopBar" Height="{DynamicResource size.titleBarHeight}" Margin="{t:Sp 'l,0'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <c:CouchLogo />
                <TextBlock Text="CouchSubs" FontWeight="Bold" FontSize="15" Margin="{t:Sp 's,0,0,0'}" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="Tabs" Grid.Column="1" Style="{StaticResource TabGroup}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HomeTab" Style="{StaticResource TopTab}" GroupName="ShellTabs" Content="{t:T 'Home'}" Checked="OnTab" IsChecked="True" />
                    <RadioButton x:Name="HistoryTab" Style="{StaticResource TopTab}" GroupName="ShellTabs" Content="{t:T 'History'}" Checked="OnTab" />
                    <RadioButton x:Name="SettingsTab" Style="{StaticResource TopTab}" GroupName="ShellTabs" Content="{t:T 'Settings'}" Checked="OnTab" />
                </StackPanel>
            </Border>
            <c:StatusPill x:Name="Status" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />

        <c:AdBand x:Name="Ads" Grid.Row="2" />
    </Grid>
</Window>

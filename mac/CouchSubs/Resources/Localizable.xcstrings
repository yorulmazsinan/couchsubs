        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın programınız localhost'u kabul etmiyor mu (ör. TikTok LIVE Studio)? Bilgisayarın ağ adresiyle bu adresi kullanın:"
          }
        }
      }
    },

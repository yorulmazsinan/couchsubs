            "value": "The Xbox service sent an unexpected reply (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox hizmeti beklenmedik yanıt verdi (%@)."
          }
        }
      }
    },
    "Can't reach your Xbox. Is it on, and is remote play enabled in Settings › Devices & connections › Remote features? Retrying…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your Xbox. Is it on, and is remote play enabled in Settings › Devices & connections › Remote features? Retrying…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'a ulaşılamadı. Xbox açık mı ve Ayarlar › Cihazlar ve bağlantılar › Uzak özellikler'de uzaktan oynatma açık mı? Yeniden deneniyor…"
          }
        }
      }
    },
    "Your Xbox is in another remote play session. Close it; retrying…": {
      "localizations": {

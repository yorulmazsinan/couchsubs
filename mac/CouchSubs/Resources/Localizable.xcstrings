    "STEP %lld / %lld": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "STEP %lld / %lld"}}, "tr": {"stringUnit": {"state": "translated", "value": "ADIM %lld / %lld"}}}},
    "Skip for Now": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Skip for Now"}}, "tr": {"stringUnit": {"state": "translated", "value": "Şimdilik Geç"}}}},
    "Which console do you play on?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Which console do you play on?"}}, "tr": {"stringUnit": {"state": "translated", "value": "Hangi konsolda oynuyorsunuz?"}}}},
    "CouchSubs gets the picture from the console over your local network. Nothing is installed on your console.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "CouchSubs gets the picture from the console over your local network. Nothing is installed on your console."}}, "tr": {"stringUnit": {"state": "translated", "value": "CouchSubs görüntüyü konsoldan yerel ağ üzerinden alır. Konsolunuza hiçbir şey kurulmaz."}}}},
    "With Remote Play": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "With Remote Play"}}, "tr": {"stringUnit": {"state": "translated", "value": "Uzaktan Oynatma ile"}}}},
    "Xbox Series": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Xbox Series"}}, "tr": {"stringUnit": {"state": "translated", "value": "Xbox Series"}}}},
    "With Remote Features": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "With Remote Features"}}, "tr": {"stringUnit": {"state": "translated", "value": "Uzak Özellikler ile"}}}},
    "WINDOW": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "WINDOW"}}, "tr": {"stringUnit": {"state": "translated", "value": "PENCERE"}}}},
    "Game Window": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Game Window"}}, "tr": {"stringUnit": {"state": "translated", "value": "Oyun Penceresi"}}}},
    "Remote Play, OBS, Capture Card": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remote Play, OBS, Capture Card"}}, "tr": {"stringUnit": {"state": "translated", "value": "Remote Play, OBS, Capture Kartı"}}}},
    "You can change the console later in Settings.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "You can change the console later in Settings."}}, "tr": {"stringUnit": {"state": "translated", "value": "Konsolu sonra Ayarlar'dan değiştirebilirsiniz."}}}},
    "SETUP · ACCOUNT": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "SETUP · ACCOUNT"}}, "tr": {"stringUnit": {"state": "translated", "value": "KURULUM · HESAP"}}}},
    "Second PlayStation Account": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Second PlayStation Account"}}, "tr": {"stringUnit": {"state": "translated", "value": "İkinci PlayStation Hesabı"}}}},
    "CouchSubs connects to the PS5 by itself with a second account. You keep playing with your main account.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "CouchSubs connects to the PS5 by itself with a second account. You keep playing with your main account."}}, "tr": {"stringUnit": {"state": "translated", "value": "CouchSubs PS5'e ikinci hesapla kendisi bağlanır. Siz ana hesabınızla oynamaya devam edersiniz."}}}},
    "DONE ONCE": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "DONE ONCE"}}, "tr": {"stringUnit": {"state": "translated", "value": "BİR KEZ YAPILIR"}}}},
    "Create a free account on playstation.com with a different email address.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Create a free account on playstation.com with a different email address."}}, "tr": {"stringUnit": {"state": "translated", "value": "playstation.com'da farklı bir e-posta adresiyle ücretsiz bir hesap açın."}}}},
    "While still on the new user, go to Settings › System › Remote Play and turn on Enable Remote Play.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "While still on the new user, go to Settings › System › Remote Play and turn on Enable Remote Play."}}, "tr": {"stringUnit": {"state": "translated", "value": "Hâlâ yeni kullanıcıdayken Ayarlar › Sistem › Uzaktan Oynama'ya gidip Uzaktan Oynama'yı Etkinleştir'i açın."}}}},
    "Sony's PS Remote Play app can't be used meanwhile.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sony's PS Remote Play app can't be used meanwhile."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu sırada Sony'nin PS Remote Play uygulaması kullanılamaz."}}}},
    "I Don't Have a Second Account: Read the Remote Play Window": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "I Don't Have a Second Account: Read the Remote Play Window"}}, "tr": {"stringUnit": {"state": "translated", "value": "İkinci Hesabım Yok: Remote Play Penceresini Oku"}}}},
    "Scan with Your Phone": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Scan with Your Phone"}}, "tr": {"stringUnit": {"state": "translated", "value": "Telefonla Okutun"}}}},
    "The code opens Sony's free account sign-up page.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The code opens Sony's free account sign-up page."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kod, Sony'nin ücretsiz hesap açma sayfasını açar."}}}},
    "Open the Page on This Mac": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open the Page on This Mac"}}, "tr": {"stringUnit": {"state": "translated", "value": "Sayfayı Bu Mac'te Aç"}}}},
    "Sign In with the Second Account": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sign In with the Second Account"}}, "tr": {"stringUnit": {"state": "translated", "value": "İkinci Hesapla Giriş Yap"}}}},
    "Waiting for Sign-In in the Browser…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Waiting for Sign-In in the Browser…"}}, "tr": {"stringUnit": {"state": "translated", "value": "Tarayıcıda Giriş Bekleniyor…"}}}},
    "Signed In": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Signed In"}}, "tr": {"stringUnit": {"state": "translated", "value": "Giriş Yapıldı"}}}},
    "The account is stored on this Mac. You can change it any time in Settings › Console and Source.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The account is stored on this Mac. You can change it any time in Settings › Console and Source."}}, "tr": {"stringUnit": {"state": "translated", "value": "Hesap bu Mac'te saklanır. İstediğiniz zaman Ayarlar › Konsol ve Kaynak'tan değiştirebilirsiniz."}}}},
    "Sign In Again": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sign In Again"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yeniden Giriş Yap"}}}},
    "If sign-in opens in the browser, finish it there; the app continues by itself.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "If sign-in opens in the browser, finish it there; the app continues by itself."}}, "tr": {"stringUnit": {"state": "translated", "value": "Giriş tarayıcıda açılırsa orada tamamlayın, uygulama kendiliğinden devam eder."}}}},
    "Let's Connect to the PS5": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Let's Connect to the PS5"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5'e Bağlanalım"}}}},
    "You signed in with your free second PlayStation account. Now we're looking for the PS5 on the same network.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "You signed in with your free second PlayStation account. Now we're looking for the PS5 on the same network."}}, "tr": {"stringUnit": {"state": "translated", "value": "Ücretsiz ikinci PlayStation hesabınızla giriş yaptınız. Şimdi aynı ağdaki PS5'i arıyoruz."}}}},
    "Searching for the PS5": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Searching for the PS5"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 Aranıyor"}}}},
    "Scanning devices on the same network.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Scanning devices on the same network."}}, "tr": {"stringUnit": {"state": "translated", "value": "Aynı ağdaki cihazlar taranıyor."}}}},
    "PS5 Found": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "PS5 Found"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 Bulundu"}}}},
    "Choose the one you want to connect to.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose the one you want to connect to."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlanmak istediğinizi seçin."}}}},
    "Searching…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Searching…"}}, "tr": {"stringUnit": {"state": "translated", "value": "Aranıyor…"}}}},
    "Search Again": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Search Again"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yeniden Ara"}}}},
    "In Rest Mode": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "In Rest Mode"}}, "tr": {"stringUnit": {"state": "translated", "value": "Dinlenme Modunda"}}}},
    "Can't Find the PS5?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Can't Find the PS5?"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 Bulunamadı mı?"}}}},
    "The PS5 and this Mac must be on the same Wi-Fi network. On the PS5, Stay Connected to the Internet must be on in Settings › System › Power Saving. Turn off any VPN. A 5 GHz network works better.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 and this Mac must be on the same Wi-Fi network. On the PS5, Stay Connected to the Internet must be on in Settings › System › Power Saving. Turn off any VPN. A 5 GHz network works better."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 ile bu Mac aynı Wi-Fi ağında olmalı. PS5'te Ayarlar › Sistem › Güç Tasarrufu'nda \"İnternete Bağlı Kal\" açık olmalı. VPN açıksa kapatın. 5 GHz ağ daha iyi çalışır."}}}},
    "Check What's Missing": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check What's Missing"}}, "tr": {"stringUnit": {"state": "translated", "value": "Neyin Eksik Olduğunu Denetle"}}}},
    "Manual IP Address": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Manual IP Address"}}, "tr": {"stringUnit": {"state": "translated", "value": "Elle IP Adresi"}}}},
    "CONNECTION": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "CONNECTION"}}, "tr": {"stringUnit": {"state": "translated", "value": "BAĞLANTI"}}}},
    "PlayStation Account": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "PlayStation Account"}}, "tr": {"stringUnit": {"state": "translated", "value": "PlayStation Hesabı"}}}},
    "Signed in with the second account.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Signed in with the second account."}}, "tr": {"stringUnit": {"state": "translated", "value": "İkinci hesapla giriş yapıldı."}}}},
    "%@ selected.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ selected."}}, "tr": {"stringUnit": {"state": "translated", "value": "%@ seçildi."}}}},
    "Pairing and First Picture": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pairing and First Picture"}}, "tr": {"stringUnit": {"state": "translated", "value": "Eşleşme ve İlk Görüntü"}}}},
    "Setting up an encrypted connection with the PS5.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Setting up an encrypted connection with the PS5."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 ile şifreli bağlantı kuruluyor."}}}},
    "Always start the game on the PS5 with your main account. CouchSubs only watches the picture and never touches the game.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Always start the game on the PS5 with your main account. CouchSubs only watches the picture and never touches the game."}}, "tr": {"stringUnit": {"state": "translated", "value": "Oyunu her zaman PS5'te ana hesabınızla başlatın. CouchSubs yalnız görüntüyü izler, oyuna dokunmaz."}}}},
    "If the PS5 isn't found, tips open after 10 seconds.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "If the PS5 isn't found, tips open after 10 seconds."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 bulunamazsa 10 saniye sonra ipuçları açılır."}}}},
    "PS5 Login Passcode": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "PS5 Login Passcode"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 Giriş Şifresi"}}}},
    "COULDN'T CONNECT TO THE PS5": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "COULDN'T CONNECT TO THE PS5"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5'E BAĞLANILAMADI"}}}},
    "Here's What We Checked": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Here's What We Checked"}}, "tr": {"stringUnit": {"state": "translated", "value": "Neyin Eksik Olduğuna Baktık"}}}},
    "Fix the item with a problem and press Try Again. Things we couldn't read are shown as \"Unknown\".": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Fix the item with a problem and press Try Again. Things we couldn't read are shown as \"Unknown\"."}}, "tr": {"stringUnit": {"state": "translated", "value": "Sorunlu maddeyi düzeltip Yeniden Dene'ye basın. Okuyamadığımız şeyleri \"Bilinmiyor\" olarak gösteriyoruz."}}}},
    "Same Network": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Same Network"}}, "tr": {"stringUnit": {"state": "translated", "value": "Aynı Ağ"}}}},
    "This Mac and the PS5 appear to be on the same network.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac and the PS5 appear to be on the same network."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac ve PS5 aynı ağda görünüyor."}}}},
    "This Mac isn't connected to a local network. Connect it to the same Wi-Fi as the PS5.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac isn't connected to a local network. Connect it to the same Wi-Fi as the PS5."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac yerel bir ağa bağlı değil. PS5 ile aynı Wi-Fi ağına bağlayın."}}}},
    "PS5 Responds": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "PS5 Responds"}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 Yanıt Veriyor"}}}},
    "The PS5 was found.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 was found."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 bulundu."}}}},
    "The PS5 didn't answer the search. The PS5 must be on or in rest mode.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 didn't answer the search. The PS5 must be on or in rest mode."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 aramaya yanıt vermedi. PS5 açık ya da dinlenme modunda olmalı."}}}},
    "Remote Play On": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remote Play On"}}, "tr": {"stringUnit": {"state": "translated", "value": "Uzaktan Oynama Açık"}}}},
    "On the second user, Settings › System › Remote Play › Enable Remote Play must be on.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "On the second user, Settings › System › Remote Play › Enable Remote Play must be on."}}, "tr": {"stringUnit": {"state": "translated", "value": "İkinci kullanıcıda Ayarlar › Sistem › Uzaktan Oynama › Uzaktan Oynama'yı Etkinleştir açık olmalı."}}}},
    "Internet in Rest Mode": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Internet in Rest Mode"}}, "tr": {"stringUnit": {"state": "translated", "value": "Dinlenme Modunda İnternet"}}}},
    "Staying connected to the internet in rest mode must be on; otherwise the PS5 can't be woken up.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Staying connected to the internet in rest mode must be on; otherwise the PS5 can't be woken up."}}, "tr": {"stringUnit": {"state": "translated", "value": "Dinlenme modunda PS5'in internete bağlı kalması açık olmalı; yoksa uyandırılamaz."}}}},
    "Wi-Fi 5 GHz": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Wi-Fi 5 GHz"}}, "tr": {"stringUnit": {"state": "translated", "value": "Wi-Fi 5 GHz"}}}},
    "You're on a 5 GHz network.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "You're on a 5 GHz network."}}, "tr": {"stringUnit": {"state": "translated", "value": "5 GHz ağdasınız."}}}},
    "This Mac is on a 2.4 GHz network. A 5 GHz network works more smoothly and reliably.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac is on a 2.4 GHz network. A 5 GHz network works more smoothly and reliably."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac 2,4 GHz ağda. 5 GHz ağ daha akıcı ve kararlı çalışır."}}}},
    "This Mac is connected by cable or the Wi-Fi band couldn't be read.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac is connected by cable or the Wi-Fi band couldn't be read."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac kabloyla bağlı ya da Wi-Fi bandı okunamadı."}}}},
    "VPN Off": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "VPN Off"}}, "tr": {"stringUnit": {"state": "translated", "value": "VPN Kapalı"}}}},
    "No active VPN was found.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No active VPN was found."}}, "tr": {"stringUnit": {"state": "translated", "value": "Açık VPN bulunmadı."}}}},
    "A VPN is on. Turn it off while playing; it can hide the PS5.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A VPN is on. Turn it off while playing; it can hide the PS5."}}, "tr": {"stringUnit": {"state": "translated", "value": "Açık bir VPN var. Oynarken kapatın; PS5'i gizleyebilir."}}}},
    "Passed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Passed"}}, "tr": {"stringUnit": {"state": "translated", "value": "Geçti"}}}},

            "state": "translated",
            "value": "TV uygulaması kurulamadı. Tekrar deneyin."
          }
        }
      }
    },
    "The TV is out of free space. Remove an app you do not use from the TV and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV is out of free space. Remove an app you do not use from the TV and try again."
          }

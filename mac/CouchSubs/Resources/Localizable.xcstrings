    "The key is stored only in this Mac's keychain.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The key is stored only in this Mac's keychain."}}, "tr": {"stringUnit": {"state": "translated", "value": "Anahtar yalnız bu Mac'in anahtar zincirinde saklanır."}}}},

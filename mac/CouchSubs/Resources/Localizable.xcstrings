            "state": "translated",
            "value": "About CouchSubs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs Hakkında"
          }
        }
      }
    },
    "Above the English subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the English subtitle"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce altyazının üstünde"
          }
        }
      }
    },
    "Accept the request on the TV…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the request on the TV…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki isteği onaylayın…"
          }
        }
      }
    },
    "Adjust the frame so it covers where the game shows its subtitles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the frame so it covers where the game shows its subtitles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerçeveyi, oyunun altyazıyı gösterdiği alanı kaplayacak şekilde ayarlayın."
          }
        }
      }
    },
    "An LG TV with the CouchSubs TV app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An LG TV with the CouchSubs TV app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs TV uygulaması kurulu bir LG TV"
          }
        }
      }
    },

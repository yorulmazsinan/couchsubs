        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynarken CouchSubs ekranda açık kalsın. iOS, arka plana geçen uygulamanın bağlantısını keser; çeviri sürerken ekran kararmaz."
          }
        }
      }

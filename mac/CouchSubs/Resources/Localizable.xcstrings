          }
        }
      }
    },
    "The disk is almost full (%.1f GB free). macOS needs free space to read text; free up a few GB and start the translation again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk is almost full (%.1f GB free). macOS needs free space to read text; free up a few GB and start the translation again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk neredeyse dolu (%.1f GB boş). macOS'in yazıyı okuyabilmesi için boş yer gerekiyor; birkaç GB yer açıp çeviriyi yeniden başlatın."
          }
        }
      }
    },
    "Text reading got stuck. Quit CouchSubs (⌘Q), open it again and start the translation.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text reading got stuck. Quit CouchSubs (⌘Q), open it again and start the translation."}},"tr":{"stringUnit":{"state":"translated","value":"Yazı okuma takıldı. CouchSubs'tan çıkıp (⌘Q) yeniden açın ve çeviriyi başlatın."}}}},
    "Restart the Mac and start the translation again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the Mac and start the translation again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'i yeniden başlatıp çeviriyi yeniden başlatın."

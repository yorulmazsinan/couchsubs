    "A game pack with this ID already exists. Replacing it will overwrite the installed pack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game pack with this ID already exists. Replacing it will overwrite the installed pack."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimlikle kurulu bir oyun paketi zaten var. Değiştirirseniz yeni paket kurulu paketin üzerine yazılır."
          }
        }
      }
    },
    "The translation file could not be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation file could not be read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri dosyası okunamadı."
          }
        }
      }
    },
    "The translation file could not be imported. Check its format and encoding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation file could not be imported. Check its format and encoding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri dosyası içe aktarılamadı. Biçimini ve karakter kodlamasını kontrol edin."
          }
        }
      }
    },
    "The file contains no usable translations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains no usable translations."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada kullanılabilir çeviri yok."
          }
        }
      }
    },
    "The selected file is already at the install location. Choose a different game title.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is already at the install location. Choose a different game title."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dosya zaten yükleme konumunda. Farklı bir oyun adı seçin."
          }
        }
      }
    },
    "The game pack could not be installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game pack could not be installed."
          }
        },
        "tr": {

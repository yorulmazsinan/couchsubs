          }
        }
      }
    },
    "Free. The translation model built into CouchSubs runs on this computer; subtitle text never leaves it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free. The translation model built into CouchSubs runs on this computer; subtitle text never leaves it."

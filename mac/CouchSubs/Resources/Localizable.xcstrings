            "state": "translated",
            "value": "Xbox bağlantısı koptu. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "No picture from the Xbox. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No picture from the Xbox. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox'tan görüntü gelmiyor. Yeniden bağlanılıyor…"

    "Plays only on the first launch.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Plays only on the first launch."}}, "tr": {"stringUnit": {"state": "translated", "value": "Yalnız ilk açılışta çalar."}}}},
    "Transition Animations": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Transition Animations"}}, "tr": {"stringUnit": {"state": "translated", "value": "Geçiş Animasyonları"}}}},
    "When off, only a short fade is used.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "When off, only a short fade is used."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kapalıyken yalnız kısa solma kullanılır."}}}},
    "SUBTITLE APPEARANCE": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "SUBTITLE APPEARANCE"}}, "tr": {"stringUnit": {"state": "translated", "value": "ALTYAZI GÖRÜNÜMÜ"}}}},
    "Text size, background, text and character name colors. The settings apply the same on the TV, phone and computer screen.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Text size, background, text and character name colors. The settings apply the same on the TV, phone and computer screen."}}, "tr": {"stringUnit": {"state": "translated", "value": "Yazı boyutu, zemin, yazı ve karakter adı renkleri. Ayarlar TV, telefon ve bilgisayar ekranında aynı uygulanır."}}}},
    "Edit Subtitle Appearance": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit Subtitle Appearance"}}, "tr": {"stringUnit": {"state": "translated", "value": "Altyazı Görünümünü Düzenle"}}}},

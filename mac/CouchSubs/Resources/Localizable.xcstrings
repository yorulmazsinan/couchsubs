    "A menu is open in the game; there's no subtitle.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A menu is open in the game; there's no subtitle."}}, "tr": {"stringUnit": {"state": "translated", "value": "Oyunda menü açık, altyazı yok."}}}},
    "We don't translate the text in the pause menu. The subtitles come back by themselves when you return to the game.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "We don't translate the text in the pause menu. The subtitles come back by themselves when you return to the game."}}, "tr": {"stringUnit": {"state": "translated", "value": "Duraklatma menüsündeki yazıları çevirmiyoruz. Oyuna dönünce altyazı kendiliğinden gelir."}}}},

            "value": "TV'deki eski kopya kaldırılıyor…"
          }
        }
      }
    },
    "Opening the app on the TV…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the app on the TV…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de uygulama açılıyor…"
          }
        }
      }
    },
    "Installed: CouchSubs %@ is opening on the TV.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed: CouchSubs %@ is opening on the TV."
          }
        },

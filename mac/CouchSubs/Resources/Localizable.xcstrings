            "state": "translated",
            "value": "Your Xbox is in another remote play session. Close it; retrying…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox başka bir uzaktan oynatmada. Onu kapatın; yeniden deneniyor…"
          }

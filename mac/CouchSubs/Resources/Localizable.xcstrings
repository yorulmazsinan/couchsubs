    "Accurate": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Accurate"}}, "tr": {"stringUnit": {"state": "translated", "value": "Doğru"}}}},
    "Subtitles arrive as fast as possible; you may rarely see half a sentence.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Subtitles arrive as fast as possible; you may rarely see half a sentence."}}, "tr": {"stringUnit": {"state": "translated", "value": "Altyazı en hızlı biçimde gelir; nadiren yarım cümle görebilirsiniz."}}}},
    "Recommended for most games. Speed and accuracy balanced.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recommended for most games. Speed and accuracy balanced."}}, "tr": {"stringUnit": {"state": "translated", "value": "Çoğu oyun için önerilen ayar. Hız ve doğruluk dengeli."}}}},
    "Translated once the sentence is complete; arrives about half a second later.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Translated once the sentence is complete; arrives about half a second later."}}, "tr": {"stringUnit": {"state": "translated", "value": "Cümle tamamlanınca çevrilir; yarım saniye kadar geç gelir."}}}},
    "Translation Language": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Translation Language"}}, "tr": {"stringUnit": {"state": "translated", "value": "Çeviri Dili"}}}},
    "The game language is detected by itself.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The game language is detected by itself."}}, "tr": {"stringUnit": {"state": "translated", "value": "Oyun dili kendiliğinden bulunur."}}}},

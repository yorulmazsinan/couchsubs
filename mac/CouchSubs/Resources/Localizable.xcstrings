            "value": "Sil"
          }
        }
      }
    },
    "Delete pack?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete pack?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket silinsin mi?"
          }
        }
      }
    },
    "%@ is removed from this phone. To use it again, import the file again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is removed from this phone. To use it again, import the file again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu telefondan silinir. Yeniden kullanmak için dosyayı yeniden içe aktarmanız gerekir."
          }
        }
      }
    },
    "CouchSubs TV on the TV is signed with another key (0.9.18 and earlier were signed with an old key) or is newer than this phone's, so this version cannot be installed over it. The button below removes the TV's copy and installs the new one; the TV app's settings are deleted. If that fails, on the TV go to Settings › Apps › CouchSubs TV › Uninstall, then press Install and open here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs TV on the TV is signed with another key (0.9.18 and earlier were signed with an old key) or is newer than this phone's, so this version cannot be installed over it. The button below removes the TV's copy and installs the new one; the TV app's settings are deleted. If that fails, on the TV go to Settings › Apps › CouchSubs TV › Uninstall, then press Install and open here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki CouchSubs TV başka bir anahtarla imzalı (0.9.18 ve önceki sürümler eski bir anahtarla imzalıydı) ya da bu telefondakinden yeni; bu sürüm onun üstüne kurulamıyor. Aşağıdaki düğme TV'deki kopyayı kaldırıp yenisini kurar; TV uygulamasının ayarları silinir. Olmazsa TV'de Ayarlar › Uygulamalar › CouchSubs TV › Kaldır de, sonra burada Kur ve aç'a bas."
          }
        }
      }
    },
    "The old CouchSubs TV could not be removed from the TV, so the new one cannot be installed. Remove it on the TV yourself: Settings › Apps › See all apps › CouchSubs TV › Uninstall. Then press Install and open here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old CouchSubs TV could not be removed from the TV, so the new one cannot be installed. Remove it on the TV yourself: Settings › Apps › See all apps › CouchSubs TV › Uninstall. Then press Install and open here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki eski CouchSubs TV kaldırılamadı, bu yüzden yenisi kurulamıyor. TV'de kendin kaldır: Ayarlar › Uygulamalar › Tüm uygulamalar › CouchSubs TV › Kaldır. Sonra burada Kur ve aç'a bas."
          }
        }
      }
    },
    "Selected window": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected window"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen pencere"}}}},
    "Choose an OBS or game window in Settings › Picture source.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an OBS or game window in Settings › Picture source."}},"tr":{"stringUnit":{"state":"translated","value":"Ayarlar › Görüntü kaynağı bölümünden bir OBS veya oyun penceresi seçin."}}}},
    "Reading the selected window": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading the selected window"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen pencere okunuyor"}}}},
    "Ready to read %@ when translation starts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ready to read %@ when translation starts."}},"tr":{"stringUnit":{"state":"translated","value":"Çeviri başlayınca %@ penceresi okunacak."}}}},
    "Waiting for the selected window: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for the selected window: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen pencere bekleniyor: %@"}}}},
    "The selected window is black. Check the OBS projector or game window.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected window is black. Check the OBS projector or game window."}},"tr":{"stringUnit":{"state":"translated","value":"Seçilen pencere siyah görünüyor. OBS projektörünü veya oyun penceresini kontrol edin."}}}},
    "Not currently open": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not currently open"}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda açık değil"}}}},
    "OBS projector or game window": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OBS projector or game window"}},"tr":{"stringUnit":{"state":"translated","value":"OBS projektörü veya oyun penceresi"}}}},
    "Open an OBS projector or game window, then select it below. Only that window is read: CouchSubs never switches to the whole desktop when it closes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open an OBS projector or game window, then select it below. Only that window is read: CouchSubs never switches to the whole desktop when it closes."}},"tr":{"stringUnit":{"state":"translated","value":"OBS projektörünü veya oyun penceresini açıp aşağıdan seçin. CouchSubs yalnızca bu pencereyi okur; pencere kapanınca tüm masaüstüne geçmez."}}}},
    "Refresh windows": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh windows"}},"tr":{"stringUnit":{"state":"translated","value":"Pencereleri yenile"}}}},
    "No suitable windows found. Open OBS or the game first, then refresh.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No suitable windows found. Open OBS or the game first, then refresh."}},"tr":{"stringUnit":{"state":"translated","value":"Uygun pencere bulunamadı. Önce OBS'yi veya oyunu açın, sonra listeyi yenileyin."}}}},
    "Have OBS or a game window on this PC?": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Have OBS or a game window on this PC?"}},"tr":{"stringUnit":{"state":"translated","value":"Bu bilgisayarda OBS veya oyun penceresi mi kullanıyorsunuz?"}}}},
    "CouchSubs can read only the OBS projector or game window you select in Settings › Picture source. No second PSN account or additional capture app is needed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CouchSubs can read only the OBS projector or game window you select in Settings › Picture source. No second PSN account or additional capture app is needed."}},"tr":{"stringUnit":{"state":"translated","value":"CouchSubs, Ayarlar › Görüntü kaynağı bölümünde seçtiğiniz OBS projektörünü veya oyun penceresini okuyabilir. İkinci PSN hesabı ya da ek yakalama uygulaması gerekmez."}}}},
    "Sponsored": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sponsored"}}, "tr": {"stringUnit": {"state": "translated", "value": "Sponsorlu"}}}},
    "Open link": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open link"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bağlantıyı aç"}}}},
    "TV not in the list? Enter its IP address (on the TV under Settings › Network).": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "TV not in the list? Enter its IP address (on the TV under Settings › Network)."}}, "tr": {"stringUnit": {"state": "translated", "value": "TV listede yok mu? IP adresini yazın (TV'de Ayarlar › Ağ altında)."}}}},
    "The PS5 did not accept the connection yet. It may still be starting up, or its network address may have changed. Reconnecting and searching for the PS5… If this keeps happening, make sure the PS5 is on and on the same network.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 did not accept the connection yet. It may still be starting up, or its network address may have changed. Reconnecting and searching for the PS5… If this keeps happening, make sure the PS5 is on and on the same network."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 bağlantıyı henüz kabul etmedi. PS5 yeni açılıyor olabilir ya da ağdaki adresi değişmiş olabilir. Yeniden bağlanılıyor ve PS5 ağda aranıyor… Sürerse PS5'in açık ve aynı ağda olduğundan emin olun."}}}},
    "Add": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Add"}}, "tr": {"stringUnit": {"state": "translated", "value": "Ekle"}}}},
    "The PS5 is on the network but is not waiting for a code. On the PS5 open Settings › System › Remote Play › Pair Device and enter the new code it shows. If the PS5 is in rest mode, turn it on first.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 is on the network but is not waiting for a code. On the PS5 open Settings › System › Remote Play › Pair Device and enter the new code it shows. If the PS5 is in rest mode, turn it on first."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 ağda ama kod beklemiyor. PS5'te Ayarlar › Sistem › Uzaktan Oynatma › Cihazı Eşleştir'i açın ve ekranda çıkan yeni kodu girin. PS5 dinlenme modundaysa önce açın."}}}},
    "The PS5 answered, but the pairing connection to it could not be opened. Turn off any VPN or firewall app that blocks the home network, then open Pair Device again on the PS5 and enter the new code.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 answered, but the pairing connection to it could not be opened. Turn off any VPN or firewall app that blocks the home network, then open Pair Device again on the PS5 and enter the new code."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 yanıt verdi ama eşleştirme bağlantısı açılamadı. Ev ağını engelleyen VPN ya da güvenlik duvarı uygulaması varsa kapatın, sonra PS5'te Cihazı Eşleştir'i yeniden açıp yeni kodu girin."}}}},
    "This computer has no free network ports left, so it cannot connect to the PS5. Restart the computer, then open Pair Device again on the PS5 and enter the new code.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This computer has no free network ports left, so it cannot connect to the PS5. Restart the computer, then open Pair Device again on the PS5 and enter the new code."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu bilgisayarda boş ağ bağlantı noktası (port) kalmadı, bu yüzden PS5'e bağlanamıyor. Bilgisayarı yeniden başlatın, sonra PS5'te Cihazı Eşleştir'i yeniden açıp yeni kodu girin."}}}},
    "This phone has no free network ports left, so it cannot connect to the PS5. Restart the phone, then open Pair Device again on the PS5 and enter the new code.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This phone has no free network ports left, so it cannot connect to the PS5. Restart the phone, then open Pair Device again on the PS5 and enter the new code."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu telefonda boş ağ bağlantı noktası (port) kalmadı, bu yüzden PS5'e bağlanamıyor. Telefonu yeniden başlatın, sonra PS5'te Cihazı Eşleştir'i yeniden açıp yeni kodu girin."}}}},
    "Your Xbox is streaming to another device (the Xbox app, a phone or a PC). Close that session, then start translation again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Your Xbox is streaming to another device (the Xbox app, a phone or a PC). Close that session, then start translation again."}}, "tr": {"stringUnit": {"state": "translated", "value": "Xbox şu an başka bir cihaza yayın yapıyor (Xbox uygulaması, telefon ya da bilgisayar). O oturumu kapatıp çeviriyi yeniden başlatın."}}}},
    "Can't reach your Xbox. Make sure it's on and remote play is enabled in Settings › Devices & connections › Remote features, then start translation again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Can't reach your Xbox. Make sure it's on and remote play is enabled in Settings › Devices & connections › Remote features, then start translation again."}}, "tr": {"stringUnit": {"state": "translated", "value": "Xbox'a ulaşılamadı. Xbox'ın açık olduğundan ve Ayarlar › Cihazlar ve bağlantılar › Uzak özellikler'de uzaktan oynatmanın açık olduğundan emin olup çeviriyi yeniden başlatın."}}}},
    "The Xbox stream stopped (%@). Start translation again; if it keeps stopping, restart the Xbox.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The Xbox stream stopped (%@). Start translation again; if it keeps stopping, restart the Xbox."}}, "tr": {"stringUnit": {"state": "translated", "value": "Xbox yayını durdu (%@). Çeviriyi yeniden başlatın; sürekli duruyorsa Xbox'ı yeniden başlatın."}}}},
    "The Xbox stopped answering keep-alive requests.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The Xbox stopped answering keep-alive requests."}}, "tr": {"stringUnit": {"state": "translated", "value": "Xbox canlı tutma isteklerine yanıt vermedi."}}}},
    "OK": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "OK"}}, "tr": {"stringUnit": {"state": "translated", "value": "Tamam"}}}},
    "Updating…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Updating…"}}, "tr": {"stringUnit": {"state": "translated", "value": "Güncelleniyor…"}}}},
    "Packs are up to date": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Packs are up to date"}}, "tr": {"stringUnit": {"state": "translated", "value": "Paketler güncel"}}}},
    "The packs are already up to date.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The packs are already up to date."}}, "tr": {"stringUnit": {"state": "translated", "value": "Paketler zaten güncel."}}}},
    "Packs updated": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Packs updated"}}, "tr": {"stringUnit": {"state": "translated", "value": "Paketler güncellendi"}}}},
    "The packs could not be updated": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The packs could not be updated"}}, "tr": {"stringUnit": {"state": "translated", "value": "Paketler güncellenemedi"}}}},
    "The packs on this phone are still used.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The packs on this phone are still used."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu telefondaki paketler kullanılmaya devam ediyor."}}}},
    "1 pack updated: %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "1 pack updated: %@."}}, "tr": {"stringUnit": {"state": "translated", "value": "1 paket güncellendi: %@."}}}},
    "%lld packs updated: %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld packs updated: %@."}}, "tr": {"stringUnit": {"state": "translated", "value": "%lld paket güncellendi: %@."}}}},
    "1 pack added: %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "1 pack added: %@."}}, "tr": {"stringUnit": {"state": "translated", "value": "1 paket eklendi: %@."}}}},
    "%lld packs added: %@.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld packs added: %@."}}, "tr": {"stringUnit": {"state": "translated", "value": "%lld paket eklendi: %@."}}}},
    "%1$@ (%2$@ lines)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%1$@ (%2$@ lines)"}}, "tr": {"stringUnit": {"state": "translated", "value": "%1$@ (%2$@ satır)"}}}},
    "%1$@ (+%2$@ lines)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%1$@ (+%2$@ lines)"}}, "tr": {"stringUnit": {"state": "translated", "value": "%1$@ (+%2$@ satır)"}}}},
    "%1$@ (%2$@ fewer lines)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%1$@ (%2$@ fewer lines)"}}, "tr": {"stringUnit": {"state": "translated", "value": "%1$@ (%2$@ satır azaldı)"}}}},
    "%@ (translations revised)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ (translations revised)"}}, "tr": {"stringUnit": {"state": "translated", "value": "%@ (çeviriler düzeltildi)"}}}},
    "%@ new lines in total.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ new lines in total."}}, "tr": {"stringUnit": {"state": "translated", "value": "Toplam %@ yeni satır."}}}},
    "No internet connection, or the pack server could not be reached.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No internet connection, or the pack server could not be reached."}}, "tr": {"stringUnit": {"state": "translated", "value": "İnternet bağlantısı yok ya da paket sunucusuna ulaşılamadı."}}}},
    "Too many attempts. Wait a few minutes and try again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Too many attempts. Wait a few minutes and try again."}}, "tr": {"stringUnit": {"state": "translated", "value": "Çok sık denendi. Birkaç dakika bekleyip yeniden deneyin."}}}},
    "The pack server did not respond (HTTP %lld).": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The pack server did not respond (HTTP %lld)."}}, "tr": {"stringUnit": {"state": "translated", "value": "Paket sunucusu yanıt vermedi (HTTP %lld)."}}}},
    "A downloaded pack could not be verified; it may have arrived incomplete.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A downloaded pack could not be verified; it may have arrived incomplete."}}, "tr": {"stringUnit": {"state": "translated", "value": "İndirilen bir paket doğrulanamadı; eksik inmiş olabilir."}}}},
    "The response from the pack server could not be read.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The response from the pack server could not be read."}}, "tr": {"stringUnit": {"state": "translated", "value": "Paket sunucusundan gelen yanıt okunamadı."}}}}
  },
  "version": "1.0"
}

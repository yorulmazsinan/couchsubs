    "Setup takes about 3 minutes.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Setup takes about 3 minutes."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kurulum yaklaşık 3 dakika sürer."}}}},
    "Replay with Sound": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Replay with Sound"}}, "tr": {"stringUnit": {"state": "translated", "value": "Sesli Yeniden Oynat"}}}},
    "Replay Silently": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Replay Silently"}}, "tr": {"stringUnit": {"state": "translated", "value": "Sessiz Oynat"}}}},

    },
    "Imported packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan paketler"
          }
        }
      }
    },
    "Add a community translation file (JSON, TXT or bilingual SRT) as a game pack. The file stays on this phone and is not sent anywhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a community translation file (JSON, TXT or bilingual SRT) as a game pack. The file stays on this phone and is not sent anywhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk çeviri dosyasını (JSON, TXT ya da iki dilli SRT) oyun paketi olarak ekleyin. Dosya bu telefonda kalır, hiçbir yere gönderilmez."
          }
        }
      }
    },
    "Delete": {

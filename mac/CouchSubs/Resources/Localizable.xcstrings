    "Lines not in a pack go to the shared pool with the game's name, so a ready translation for that game arrives sooner.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lines not in a pack go to the shared pool with the game's name, so a ready translation for that game arrives sooner."}}, "tr": {"stringUnit": {"state": "translated", "value": "Pakette olmayan satırlar oyunun adıyla ortak havuza gider; böylece o oyunun hazır çevirisi daha çabuk gelir."}}}},
    "There are saved areas for %@. Use them?": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "There are saved areas for %@. Use them?"}}, "tr": {"stringUnit": {"state": "translated", "value": "%@ için kayıtlı alanlar var. Kullanılsın mı?"}}}},

    "OpenAI or Claude with your own key.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "OpenAI or Claude with your own key."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kendi anahtarınızla OpenAI ya da Claude."}}}},
    "API Key": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "API Key"}}, "tr": {"stringUnit": {"state": "translated", "value": "API Anahtarı"}}}},
    "Stored only on this device.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stored only on this device."}}, "tr": {"stringUnit": {"state": "translated", "value": "Yalnız bu cihazda saklanır."}}}},
    "EXPERIMENTAL": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "EXPERIMENTAL"}}, "tr": {"stringUnit": {"state": "translated", "value": "DENEYSEL"}}}},
    "These settings may slow down or interrupt translation. If there's a problem, go back to the defaults.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "These settings may slow down or interrupt translation. If there's a problem, go back to the defaults."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu ayarlar çeviriyi yavaşlatabilir ya da kesebilir. Sorun olursa varsayılana dönün."}}}},
    "Translate On-Screen Text Automatically": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Translate On-Screen Text Automatically"}}, "tr": {"stringUnit": {"state": "translated", "value": "Ekran Yazılarını Otomatik Çevir"}}}},
    "Objectives, menus and other text on the screen.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Objectives, menus and other text on the screen."}}, "tr": {"stringUnit": {"state": "translated", "value": "Görev, menü ve ekrandaki diğer yazılar."}}}},
    "Translate the GTA 6 Phone Automatically": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Translate the GTA 6 Phone Automatically"}}, "tr": {"stringUnit": {"state": "translated", "value": "GTA 6 Telefonunu Otomatik Çevir"}}}},
    "Each message is translated over its own bubble.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Each message is translated over its own bubble."}}, "tr": {"stringUnit": {"state": "translated", "value": "Her mesaj kendi balonunun üstünde çevrilir."}}}},
    "Restore Defaults": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restore Defaults"}}, "tr": {"stringUnit": {"state": "translated", "value": "Varsayılana Dön"}}}},
    "Follow System": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Follow System"}}, "tr": {"stringUnit": {"state": "translated", "value": "Sisteme Uy"}}}},
    "MORE": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "MORE"}}, "tr": {"stringUnit": {"state": "translated", "value": "DİĞER"}}}},
    "SUBTITLE AREA": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "SUBTITLE AREA"}}, "tr": {"stringUnit": {"state": "translated", "value": "ALTYAZI ALANI"}}}},
    "Refresh Picture": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Refresh Picture"}}, "tr": {"stringUnit": {"state": "translated", "value": "Görüntüyü Yenile"}}}},
    "Full Screen": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Full Screen"}}, "tr": {"stringUnit": {"state": "translated", "value": "Tam Ekran"}}}},
    "Drag the frame to move it, or grab an edge or corner to resize it. The subtitle frame should cover where the game shows its subtitles.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Drag the frame to move it, or grab an edge or corner to resize it. The subtitle frame should cover where the game shows its subtitles."}}, "tr": {"stringUnit": {"state": "translated", "value": "Çerçeveyi sürükleyerek taşıyın, kenarından ya da köşesinden tutup boyutlandırın. Altyazı çerçevesi oyunun altyazıyı gösterdiği yeri kapsamalı."}}}},
    "While Full Screen is selected the whole screen is read, so extra areas aren't read; choosing another area reads them again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "While Full Screen is selected the whole screen is read, so extra areas aren't read; choosing another area reads them again."}}, "tr": {"stringUnit": {"state": "translated", "value": "Tam Ekran seçiliyken ekranın tamamı okunduğu için ek alanlar okunmaz; başka bir alan seçince yeniden okunur."}}}},
    "Reset Areas": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reset Areas"}}, "tr": {"stringUnit": {"state": "translated", "value": "Alanları Sıfırla"}}}},
    "EXTRA AREAS": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "EXTRA AREAS"}}, "tr": {"stringUnit": {"state": "translated", "value": "EK ALANLAR"}}}},
    "Add Extra Area": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Add Extra Area"}}, "tr": {"stringUnit": {"state": "translated", "value": "Ek Alan Ekle"}}}},
    "Also reads small text next to the subtitle, such as objectives, phone messages or notifications. Each area is read once a second and translated again when the text changes; the translation appears on the TV next to that text.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Also reads small text next to the subtitle, such as objectives, phone messages or notifications. Each area is read once a second and translated again when the text changes; the translation appears on the TV next to that text."}}, "tr": {"stringUnit": {"state": "translated", "value": "Altyazının yanında görev, telefon mesajı ya da bildirim gibi küçük yazıları da okur. Her alan saniyede bir okunur, yazı değişince yeniden çevrilir; çeviri TV'de o yazının yanında görünür."}}}},
    "No extra areas yet.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No extra areas yet."}}, "tr": {"stringUnit": {"state": "translated", "value": "Henüz ek alan yok."}}}},
    "Area %lld": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Area %lld"}}, "tr": {"stringUnit": {"state": "translated", "value": "Alan %lld"}}}},
    "No Shortcut": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No Shortcut"}}, "tr": {"stringUnit": {"state": "translated", "value": "Kısayol Yok"}}}},
    "Objective": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Objective"}}, "tr": {"stringUnit": {"state": "translated", "value": "Görev"}}}},
    "Subtitle": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Subtitle"}}, "tr": {"stringUnit": {"state": "translated", "value": "Altyazı"}}}},
    "AREAS FOR THIS GAME": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "AREAS FOR THIS GAME"}}, "tr": {"stringUnit": {"state": "translated", "value": "BU OYUNUN ALANLARI"}}}},
    "The areas are saved for this game.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The areas are saved for this game."}}, "tr": {"stringUnit": {"state": "translated", "value": "Alanlar bu oyuna kayıtlı."}}}},
    "There are unsaved changes.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "There are unsaved changes."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kaydedilmemiş değişiklik var."}}}},
    "Saved": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved"}}, "tr": {"stringUnit": {"state": "translated", "value": "Kaydedildi"}}}},
    "Saved Games": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved Games"}}, "tr": {"stringUnit": {"state": "translated", "value": "Kayıtlı Oyunlar"}}}},
    "When one of these games starts, its areas load by themselves.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "When one of these games starts, its areas load by themselves."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu oyunlardan biri açılınca alanları kendiliğinden yüklenir."}}}},
    "Use Ready Areas for Known Games": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use Ready Areas for Known Games"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bilinen Oyunlarda Hazır Alanları Kullan"}}}},
    "Keep Centered": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keep Centered"}}, "tr": {"stringUnit": {"state": "translated", "value": "Ortada Tut"}}}},
    "Use Game Packs": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use Game Packs"}}, "tr": {"stringUnit": {"state": "translated", "value": "Oyun Paketlerini Kullan"}}}},
    "Ready Turkish translations for some games. A line found in the pack appears instantly without going to the translation engine.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ready Turkish translations for some games. A line found in the pack appears instantly without going to the translation engine."}}, "tr": {"stringUnit": {"state": "translated", "value": "Bazı oyunlar için hazır Türkçe çeviriler. Pakette bulunan satır çeviri motoruna gitmeden anında görünür."}}}},
    "Send the English Subtitles Read to the Shared Pool": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send the English Subtitles Read to the Shared Pool"}}, "tr": {"stringUnit": {"state": "translated", "value": "Okunan İngilizce Altyazıları Ortak Havuza Gönder"}}}},
    "Only the game's English text is sent, anonymously. It helps make better Turkish translations for everyone.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only the game's English text is sent, anonymously. It helps make better Turkish translations for everyone."}}, "tr": {"stringUnit": {"state": "translated", "value": "Yalnız oyunun İngilizce metni, adsız gönderilir. Herkes için daha iyi Türkçe çeviri yapmaya yarar."}}}},
    "INSTALLED PACKS": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "INSTALLED PACKS"}}, "tr": {"stringUnit": {"state": "translated", "value": "KURULU PAKETLER"}}}},

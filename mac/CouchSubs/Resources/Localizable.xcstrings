    "Free, with no quota. An AI model on this computer (Ollama or LM Studio) translates; subtitle text never leaves it. Speed depends on your computer. When the model cannot be reached, the free translation takes over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, with no quota. An AI model on this computer (Ollama or LM Studio) translates; subtitle text never leaves it. Speed depends on your computer. When the model cannot be reached, the free translation takes over."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve kotasız. Bu bilgisayardaki bir yapay zekâ modeli (Ollama ya da LM Studio) çevirir; altyazı metni bilgisayardan çıkmaz. Hız bilgisayarınıza bağlıdır. Modele ulaşılamazsa ücretsiz çeviri devreye girer."
          }
        }
      }
    },
    "The local model server did not accept the API key. Check the key, or remove it if the server does not need one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server did not accept the API key. Check the key, or remove it if the server does not need one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model sunucusu API anahtarını kabul etmedi. Anahtarı denetleyin; sunucu anahtar istemiyorsa kaldırın."
          }
        }
      }
    },
    "The local model server is busy. Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server is busy. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model sunucusu meşgul. Biraz sonra yeniden deneyin."
          }
        }
      }
    },
    "LM Studio does not have the model %@. Download and load it in LM Studio, or check the model name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio does not have the model %@. Download and load it in LM Studio, or check the model name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio'da %@ modeli yok. Modeli LM Studio'da indirip yükleyin ya da model adını denetleyin."
          }
        }
      }
    },
    "The model %1$@ is not on the local server. Download it: ollama pull %1$@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model %1$@ is not on the local server. Download it: ollama pull %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ modeli yerel sunucuda yok. Modeli indirin: ollama pull %1$@"
          }
        }
      }
    },
    "Ollama is not running: %1$@ could not be reached, or the model did not answer in time. Open Ollama and download the model: ollama pull %2$@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama is not running: %1$@ could not be reached, or the model did not answer in time. Open Ollama and download the model: ollama pull %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama çalışmıyor: %1$@ adresine ulaşılamadı ya da model zamanında yanıt vermedi. Ollama'yı açıp modeli indirin: ollama pull %2$@"
          }
        }
      }
    },
    "LM Studio is not running: %@ could not be reached, or the model did not answer in time. Open LM Studio, load the model and start the local server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio is not running: %@ could not be reached, or the model did not answer in time. Open LM Studio, load the model and start the local server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio çalışmıyor: %@ adresine ulaşılamadı ya da model zamanında yanıt vermedi. LM Studio'yu açın, modeli yükleyip yerel sunucuyu başlatın."
          }
        }
      }
    },
    "The local model server at %@ could not be reached, or the model did not answer in time. Check the address and that the server is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model server at %@ could not be reached, or the model did not answer in time. Check the address and that the server is running."

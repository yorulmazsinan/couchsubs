      }
    },
    "Could not reach Sony's sign-in server. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Sony's sign-in server. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusuna ulaşılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update CouchSubs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's answer could not be read. Sign in again; if it keeps happening, update CouchSubs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sürerse CouchSubs'ı güncelleyin."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi giriş bitmeden kapandı. Giriş yap'a basıp girişi pencerede tamamlayın."
          }
        }
      }
    },
    "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sayfası açılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Paired with %@. Connects when you start translating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@. Connects when you start translating."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile eşleşti. Çeviriyi başlatınca bağlanır."
          }
        }
      }
    },
    "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 %@ adresinde bulunamadı. Açık ve aynı ağda olduğundan emin olun. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "Lost the connection to the PS5. Reconnecting… If this keeps happening, connect the PS5 to the router with a cable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost the connection to the PS5. Reconnecting… If this keeps happening, connect the PS5 to the router with a cable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ile bağlantı koptu, yeniden bağlanılıyor… Sık oluyorsa PS5'i modeme kabloyla bağlayın."
          }
        }
      }
    },
    "Remote Play is turned off on the PS5 (code %@). On the PS5, go to Settings › System › Remote Play and turn on Enable Remote Play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Play is turned off on the PS5 (code %@). On the PS5, go to Settings › System › Remote Play and turn on Enable Remote Play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te Uzaktan Oynama kapalı (kod %@). PS5'te Ayarlar › Sistem › Uzaktan Oynama'ya gidip Uzaktan Oynama'yı Etkinleştir'i açın."
          }
        }
      }
    },
    "Reconnecting… (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting… (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlanılıyor… (%@)"
          }
        }
      }
    },
    "Picture mode (Android TV)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Picture mode (Android TV)"}}, "tr": {"stringUnit": {"state": "translated", "value": "Görüntü modu (Android TV)"}}}},
    "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If no picture arrives, the TV app first lists its HDMI inputs and switches to Overlay where it can. Overlay also helps if the TV changes its picture mode or drops Game mode or HDR while the TV app is open: inside the app the TV handles the PS5 picture as an app, not as its HDMI input. The TV app from Google Play has no Overlay mode: there this choice is not applied and the TV says so on screen.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If no picture arrives, the TV app first lists its HDMI inputs and switches to Overlay where it can. Overlay also helps if the TV changes its picture mode or drops Game mode or HDR while the TV app is open: inside the app the TV handles the PS5 picture as an app, not as its HDMI input. The TV app from Google Play has no Overlay mode: there this choice is not applied and the TV says so on screen."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 görüntüsü CouchSubs TV uygulamasının içinde siyah kalıyorsa Katman'ı seçin: TV, PS5'i kendi HDMI girişinde gösterir, altyazı görüntünün üstünde çıkar. Görüntü gelmezse TV uygulaması önce HDMI girişlerini gösterir, Katman varsa ona geçer. TV uygulaması açıkken TV'nin görüntü modu değişiyor, oyun modu ya da HDR kayboluyorsa da Katman'ı seçin: uygulamanın içinde TV, PS5 görüntüsünü HDMI girişi olarak değil uygulama olarak işler. Google Play'den kurulan TV uygulamasında Katman yok: orada bu seçim uygulanmaz, TV bunu ekranda söyler."}}}},
    "The PS5 rejected the connection (code %@). Another Remote Play app (PS Remote Play) may be open, or the PS5 may be in another session. Close PS Remote Play, restart the PS5, then try again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 rejected the connection (code %@). Another Remote Play app (PS Remote Play) may be open, or the PS5 may be in another session. Close PS Remote Play, restart the PS5, then try again."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 bağlantıyı reddetti (kod %@). Başka bir Uzaktan Oynatma (PS Remote Play) açık olabilir ya da PS5 başka bir oturumda olabilir. PS Remote Play'i kapatın, PS5'i yeniden başlatıp tekrar deneyin."}}}},
    "The PS5 didn't start the session. Another Remote Play app (PS Remote Play) may be open, or the PS5 may be in another session. Close PS Remote Play, restart the PS5, then try again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PS5 didn't start the session. Another Remote Play app (PS Remote Play) may be open, or the PS5 may be in another session. Close PS Remote Play, restart the PS5, then try again."}}, "tr": {"stringUnit": {"state": "translated", "value": "PS5 oturumu başlatmadı. Başka bir Uzaktan Oynatma (PS Remote Play) açık olabilir ya da PS5 başka bir oturumda olabilir. PS Remote Play'i kapatın, PS5'i yeniden başlatıp tekrar deneyin."}}}},
    "Overlay": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Overlay"}}, "tr": {"stringUnit": {"state": "translated", "value": "Katman"}}}},
    "Picture mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture mode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü modu"
          }
        }
      }
    },
    "Inside the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içinde"
          }
        }
      }
    },
    "Overlay (for a black screen)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay (for a black screen)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katman (siyah ekran sorunu için)"
          }
        }
      }
    },
    "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself. Overlay also helps if the TV changes its picture mode or drops Game mode or HDR while the TV app is open: inside the app the TV handles the PS5 picture as an app, not as its HDMI input.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself. Overlay also helps if the TV changes its picture mode or drops Game mode or HDR while the TV app is open: inside the app the TV handles the PS5 picture as an app, not as its HDMI input."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 görüntüsü CouchSubs TV uygulamasının içinde siyah kalıyorsa Katman'ı seçin: TV, PS5'i kendi HDMI girişinde gösterir, altyazı görüntünün üstünde çıkar. Görüntü hiç gelmezse TV uygulaması kendiliğinden Katman'a geçer. TV uygulaması açıkken TV'nin görüntü modu değişiyor, oyun modu ya da HDR kayboluyorsa da Katman'ı seçin: uygulamanın içinde TV, PS5 görüntüsünü HDMI girişi olarak değil uygulama olarak işler."
          }
        }
      }
    },
    "Copy the link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the link"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kopyala"
          }
        }
      }
    },
    "Details:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntı:"
          }
        }
      }
    },
    "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de “Sunucu bakım altında” yazıyorsa TV, Samsung'un sunucularına ulaşamıyor: TV'nin internet bağlantısını, tarih ve saatini kontrol edin, TV'yi yeniden başlatıp tekrar deneyin."
          }
        }
      }
    },
    "If the sign-in window does not open, the browser may have blocked it as a pop-up: allow pop-ups for this page from the icon in the address bar, then press Open the page again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the sign-in window does not open, the browser may have blocked it as a pop-up: allow pop-ups for this page from the icon in the address bar, then press Open the page again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi açılmazsa tarayıcı onu açılır pencere diye engellemiş olabilir: adres çubuğundaki simgeden bu sayfa için açılır pencerelere izin verin, sonra Sayfayı yeniden aç'a basın."
          }
        }
      }
    },
    "A CouchSubs TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select CouchSubs, delete it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A CouchSubs TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select CouchSubs, delete it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de başka bir bilgisayarda imzalanmış bir CouchSubs uygulaması var ve kaldırılamadı. TV'de Uygulamalar'ı açın, CouchSubs'ı seçip silin ve tekrar deneyin."
          }
        }
      }
    },
    "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. CouchSubs gets a new certificate, so you sign in to Samsung once more.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. CouchSubs gets a new certificate, so you sign in to Samsung once more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV imza sertifikasını kabul etmedi. TV'nin internete bağlı olduğundan (sertifikayı Samsung'a sorar) ve tarih ile saatinin doğru olduğundan emin olun (Ayarlar › Genel › Sistem Yöneticisi › Saat), sonra tekrar deneyin. CouchSubs yeni sertifika alacağı için Samsung hesabınızla bir kez daha giriş yaparsınız."
          }
        }
      }
    },
    "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nin saati geride olduğu için yeni sertifika TV'ye göre henüz geçerli değil. TV'nin tarih ve saatini düzeltin (Ayarlar › Genel › Sistem Yöneticisi › Saat) ya da birkaç dakika bekleyip tekrar deneyin."
          }
        }
      }
    },
    "The TV refuses CouchSubs because an earlier CouchSubs is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If CouchSubs is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refuses CouchSubs because an earlier CouchSubs is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If CouchSubs is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV, daha önceki bir CouchSubs'ın kaydı hâlâ durduğu için uygulamayı kabul etmiyor (Tizen hatası 118, -22); uygulama listede görünmese de. CouchSubs TV'nin uygulamaları arasındaysa oradan silip tekrar deneyin. Değilse Smart Hub'ı sıfırlayıp (Ayarlar › Destek › Cihaz Bakımı › Kendi Kendine Tanılama › Smart Hub'ı Sıfırla; menü adları modele göre biraz değişir) tekrar deneyin. Smart Hub'ı sıfırlamak, indirdiğiniz diğer uygulamaları da kaldırır."
          }
        }
      }
    },
    "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum sırasında TV bağlantısı koptu. TV'yi açık ve bu bilgisayarla aynı ağda tutup tekrar deneyin."
          }
        }
      }
    },
    "1. On the TV, open Apps and scroll to the very bottom of the page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Apps and scroll to the very bottom of the page."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Uygulamalar ekranını açın ve sayfanın en altına inin."
          }
        }
      }
    },
    "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Orada kumandada 1 2 3 4 5 tuşlarına basın (ya da ekran klavyesiyle 12345 yazın). Geliştirici modu penceresi açılır."
          }
        }
      }
    },
    "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung hesabı penceresi tarayıcıda açıldı, girişi orada tamamlayın. Göremiyorsanız tarayıcıya geçin ya da Sayfayı yeniden aç'a basın."
          }
        }
      }
    },
    "Samsung signs the app for your TV with your free Samsung account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung signs the app for your TV with your free Samsung account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung, uygulamayı ücretsiz Samsung hesabınızla TV'nize özel imzalar."
          }
        }
      }
    },
    "Accept the permission box on the TV with the remote (Allow). CouchSubs waits 60 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the permission box on the TV with the remote (Allow). CouchSubs waits 60 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de çıkan izin kutusunu kumandayla onaylayın (İzin ver). CouchSubs 60 saniye bekler."
          }
        }
      }
    },
    "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If CouchSubs was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If CouchSubs was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki izin kutusu 60 saniye içinde onaylanmadı. Kutu hiç çıkmadıysa TV'de ana ekranı açıp yeniden Bağlan'a basın. CouchSubs'a daha önce izin verilmediyse Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden izin verin."
          }
        }
      }
    },
    "The TV refused the connection. Allow CouchSubs in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refused the connection. Allow CouchSubs in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlantıyı reddetti. TV'de Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden CouchSubs'a izin verip yeniden Bağlan'a basın."
          }
        }
      }
    },
    "Setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum"
          }
        }
      }
    },
    "Live subtitles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live subtitles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı altyazı"
          }
        }
      }
    },
    "Shortcut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol"
          }
        }
      }
    },
    "Could not connect to the TV. Accept the request on the TV screen and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to the TV. Accept the request on the TV screen and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'ye bağlanılamadı. TV ekranındaki isteği onaylayıp yeniden deneyin."
          }
        }
      }
    },
    "To install the TV app for the first time, use CouchSubs on a computer once. After that this phone is enough.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To install the TV app for the first time, use CouchSubs on a computer once. After that this phone is enough."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV uygulamasını ilk kez kurmak için bir kez bilgisayardaki CouchSubs'ı kullanın. Sonrasında bu telefon yeterli."
          }
        }
      }
    },
    "Keep CouchSubs open on the screen while you play. iOS stops the connection when the app goes to the background; the screen stays on while translating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

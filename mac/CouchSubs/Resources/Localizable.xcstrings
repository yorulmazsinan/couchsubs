    "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 asks for this account's login passcode. Enter it in Settings, or turn off this account's login passcode on the PS5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bu hesap için giriş şifresi istiyor. Ayarlar'dan şifreyi girin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        }
      }
    },
    "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 didn't accept the login passcode in Settings. Correct it, or turn off this account's login passcode on the PS5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5, Ayarlar'daki giriş şifresini kabul etmedi. Şifreyi düzeltin ya da PS5'te bu hesabın giriş şifresini kapatın."
          }
        }
      }
    },
    "PS5 login passcode": {
      "localizations": {

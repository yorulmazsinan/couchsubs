        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'i eşle"
          }
        }
      }
    },
    "On the PS5, with the second account, choose Settings › System › Remote Play › Pair Device and type the code on the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the PS5, with the second account, choose Settings › System › Remote Play › Pair Device and type the code on the screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'te ikinci hesapla Ayarlar › Sistem › Uzaktan Oynatma › Cihazı Eşle'yi seç, ekrandaki kodu yaz."
          }
        }
      }

          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun paketi değiştirilsin mi?"
          }
        }
      }
    },
    "Replace pack": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace pack"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketi değiştir"

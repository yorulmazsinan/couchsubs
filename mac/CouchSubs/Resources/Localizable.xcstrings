    "Sample ad: ads rotate every 6 seconds.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sample ad: ads rotate every 6 seconds."}}, "tr": {"stringUnit": {"state": "translated", "value": "Örnek reklam: reklamlar sırayla, 6 saniyede bir değişir."}}}},

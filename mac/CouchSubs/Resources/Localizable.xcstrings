        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresindeki yerel model sunucusuna ulaşılamadı ya da model zamanında yanıt vermedi. Adresi ve sunucunun açık olduğunu denetleyin."
          }
        }
      }

    "Free Translation": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Free Translation"}}, "tr": {"stringUnit": {"state": "translated", "value": "Ücretsiz Çeviri"}}}},
    "No key needed.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No key needed."}}, "tr": {"stringUnit": {"state": "translated", "value": "Anahtar gerekmez."}}}},
    "On This Mac (Apple)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "On This Mac (Apple)"}}, "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac'te (Apple)"}}}},
    "Apple's translation runs on this Mac; subtitle text never leaves it.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apple's translation runs on this Mac; subtitle text never leaves it."}}, "tr": {"stringUnit": {"state": "translated", "value": "Apple'ın çevirisi bu Mac'te çalışır; altyazı metni dışarı çıkmaz."}}}},
    "Better translation with a free Google key.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Better translation with a free Google key."}}, "tr": {"stringUnit": {"state": "translated", "value": "Ücretsiz Google anahtarıyla daha iyi çeviri."}}}},
    "With your own DeepL key.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "With your own DeepL key."}}, "tr": {"stringUnit": {"state": "translated", "value": "Kendi DeepL anahtarınızla."}}}},
    "Local Model": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Local Model"}}, "tr": {"stringUnit": {"state": "translated", "value": "Yerel Model"}}}},
    "Ollama or LM Studio; no quota.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ollama or LM Studio; no quota."}}, "tr": {"stringUnit": {"state": "translated", "value": "Ollama ya da LM Studio; kota yok."}}}},

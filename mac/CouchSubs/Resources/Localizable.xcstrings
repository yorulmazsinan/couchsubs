    },
    "If Windows asks whether CouchSubs may use the network, allow it for private networks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Windows asks whether CouchSubs may use the network, allow it for private networks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows, CouchSubs'ın ağı kullanmasına izin verip vermeyeceğinizi sorarsa özel ağlar için izin verin."
          }
        }
      }
    },
    "If you don't see it, make sure the CouchSubs TV app is open and connect the TV again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't see it, make sure the CouchSubs TV app is open and connect the TV again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görmüyorsanız CouchSubs TV uygulamasının açık olduğundan emin olun ve TV'yi yeniden bağlayın."
          }
        }
      }
    },
    "In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit yerdeyken altyazıyı TV kumandasının ▲ ve ▼ tuşlarıyla da taşıyabilirsiniz."
          }
        }
      }
    },
    "In the game's audio settings, turn the dialogue (voice) volume down; keep music and effects. If the game can show speaker names in subtitles, turn them on: every character then speaks with its own voice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the game's audio settings, turn the dialogue (voice) volume down; keep music and effects. If the game can show speaker names in subtitles, turn them on: every character then speaks with its own voice."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun ses ayarlarından konuşma (diyalog) sesini kısın; müzik ve efektler kalsın. Oyun altyazıda konuşmacı adını gösterebiliyorsa bunu açın: her karakter kendi sesiyle konuşur."
          }
        }
      }
    },
    "Install on the TV": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install on the TV"
          }
        },
        "tr": {

# couchsubs.enmeraapps.com (Plesk, Apache). Cloudflare'deki _headers ve uzantısız adreslerin karşılığı.
Options -MultiViews -Indexes
DirectoryIndex index.html

RewriteEngine On
# /gizlilik -> gizlilik.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^ / [R=301,L]
# /gizlilik.html -> /gizlilik (eski bağlantılar tek adrese)
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
